     30  0000 ????
     31  0000 ????	       00 f8	   COL_GOLD   =	$F8
     32  0000 ????	       00 46	   COL_RED    =	$46
     33  0000 ????	       00 c8	   COL_GREEN  =	$C8
     34  0000 ????	       00 00	   COL_BG     =	$00
