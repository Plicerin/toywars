   1584  2b30							;-------------------------------------------------------------------------------
   1585  2b30							; JetAct (X = a launched jet): four pixels right per update; every enemy on
   1586  2b30							; its shelf takes 10 damage once the nose has passed its middle. The jet's
   1587  2b30							; health byte (unused for a jet) marks the enemy slots it has hit, so each is
   1588  2b30							; hit exactly once; at most two an update (the rest the next one), so a pack
   1589  2b30							; bunched together never dies all in one frame.
   1590  2b30				   JetAct
   1591  2b30					      SUBROUTINE
   1592  2b30		       86 b4		      stx	lt3
   1593  2b32		       bd 80 f0 	      lda	R_eX,x
   1594  2b35		       18		      clc
   1595  2b36		       69 0c		      adc	#12
   1596  2b38		       85 b1		      sta	lt0	; the nose after this step
   1597  2b3a		       bd 85 f0 	      lda	R_eLane,x
   1598  2b3d		       29 03		      and	#3
   1599  2b3f		       85 b2		      sta	lt1
   1600  2b41		       a9 02		      lda	#2
   1601  2b43		       a4 b0		      ldy	KILLED
   1602  2b45		       f0 02		      beq	.hits
   1603  2b47		       a9 01		      lda	#1	; an enemy died this frame already: one hit
   1604  2b49				   .hits
   1605  2b49		       85 b6		      sta	lt5	; hits left this update
   1606  2b4b		       a0 04		      ldy	#NENEMY-1
   1607  2b4d				   .loop
   1608  2b4d		       b9 85 f0 	      lda	R_eLane,y	; (an empty slot's shelf is $FF, a jet's 4-6)
   1609  2b50		       c5 b2		      cmp	lt1
   1610  2b52		       d0 2e		      bne	.next
   1611  2b54		       b9 80 f0 	      lda	R_eX,y
   1612  2b57		       18		      clc
   1613  2b58		       69 04		      adc	#4
   1614  2b5a		       c5 b1		      cmp	lt0
   1615  2b5c		       b0 24		      bcs	.next	; its middle is still ahead of the nose
   1616  2b5e		       a6 b4		      ldx	lt3
