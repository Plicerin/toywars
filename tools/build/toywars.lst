   1558  2b1b							;-------------------------------------------------------------------------------
   1559  2b1b							; Music (every other frame): an 8-bar toy march, eighth notes of 12 frames. Before a
   1560  2b1b							; game and at game over: melody on channel 0 and bass on channel 1; during
   1561  2b1b							; play: the melody alone, softly. A sound effect on a channel always wins;
   1562  2b1b							; the music picks up again at its next note.
   1563  2b1b				   Music
   1564  2b1b					      SUBROUTINE
   1565  2b1b		       ad c2 f0 	      lda	R_musTimer
   1566  2b1e		       18		      clc
   1567  2b1f		       69 02		      adc	#2
   1568  2b21		       c9 0c		      cmp	#12
   1569  2b23		       90 0d		      bcc	.same
   1570  2b25		       ad c1 f0 	      lda	R_musPos
   1571  2b28		       18		      clc
   1572  2b29		       69 01		      adc	#1
   1573  2b2b		       29 3f		      and	#63
   1574  2b2d		       8d 41 f0 	      sta	W_musPos
   1575  2b30		       a9 00		      lda	#0
   1576  2b32				   .same
   1577  2b32		       8d 42 f0 	      sta	W_musTimer
   1578  2b35							; melody, channel 0
   1579  2b35		       ad b9 f0 	      lda	R_sndPri
   1580  2b38		       d0 3d		      bne	.bass	; a sound effect has the channel
   1581  2b3a		       ae c1 f0 	      ldx	R_musPos
   1582  2b3d		       ad c2 f0 	      lda	R_musTimer
   1583  2b40		       d0 26		      bne	.melEnd
   1584  2b42		       bc b7 fb 	      ldy	MelNote,x	; start of an eighth
   1585  2b45		       c0 07		      cpy	#7
   1586  2b47		       f0 2e		      beq	.bass	; a tie: keep sounding
   1587  2b49		       a9 00		      lda	#0
   1588  2b4b		       c0 00		      cpy	#0
   1589  2b4d		       f0 14		      beq	.melVol	; a rest
   1590  2b4f		       a9 04		      lda	#4
   1591  2b51		       85 15		      sta	AUDC0
   1592  2b53		       b9 f8 fb 	      lda	MelF,y
   1593  2b56		       85 17		      sta	AUDF0
   1594  2b58		       a9 06		      lda	#6
   1595  2b5a		       ac db f0 	      ldy	R_state
   1596  2b5d		       c0 01		      cpy	#ST_PLAY
   1597  2b5f		       d0 02		      bne	.melVol
   1598  2b61		       a9 03		      lda	#3	; softer under the game
   1599  2b63				   .melVol
   1600  2b63		       85 19		      sta	AUDV0
   1601  2b65		       4c 77 fb 	      jmp	.bass
   1602  2b68				   .melEnd
   1603  2b68		       c9 0a		      cmp	#10	; the last two frames: a short gap before the next note
   1604  2b6a		       d0 0b		      bne	.bass
   1605  2b6c		       bd b8 fb 	      lda	MelNote+1,x	; (MelNote has a 65th byte: the first again)
   1606  2b6f		       c9 07		      cmp	#7
   1607  2b71		       f0 04		      beq	.bass
   1608  2b73		       a9 00		      lda	#0
   1609  2b75		       85 19		      sta	AUDV0
   1610  2b77				   .bass
   1611  2b77							; bass, channel 1: only before a game and at game over
   1612  2b77		       ad ba f0 	      lda	R_sndPri+1
   1613  2b7a		       d0 0b		      bne	.done
