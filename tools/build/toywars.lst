    612  0545							;-------------------------------------------------------------------------------
    613  0545							; SelectEnemies (VBLANK): decide which enemies player 1 draws this frame. Each enemy needs rows E-1 .. feet, where E is its event row (the
    614  0545							; first row at or above top-1 that the kernel allows) and E-1 is blank. They
    615  0545							; are sorted by E; one that overlaps an enemy already taken waits.
    616  0545				   SelectEnemies
    617  0545					      SUBROUTINE
    618  0545		       a2 04		      ldx	#NENEMY-1	; (eFeet/eTop come from EnemyRows in bank 2)
    619  0547				   .clear
    620  0547		       b5 a8		      lda	eOrder,x	; forget last frame's choice, keep the order
    621  0549		       29 7f		      and	#$7F
    622  054b		       95 a8		      sta	eOrder,x
    623  054d		       ca		      dex
    624  054e		       10 f7		      bpl	.clear
    625  0550							; insertion sort of eOrder by eTop (nearly sorted already: cheap)
    626  0550		       a2 01		      ldx	#1
    627  0552				   .so
    628  0552		       86 b0		      stx	temp+3
    629  0554		       b5 a8		      lda	eOrder,x
    630  0556		       85 ad		      sta	temp
    631  0558		       a8		      tay
    632  0559		       b9 9e 00 	      lda	eTop,y
    633  055c		       85 ae		      sta	temp+1
    634  055e		       a4 b0		      ldy	temp+3
    635  0560				   .si
    636  0560		       b6 a7		      ldx	eOrder-1,y
    637  0562		       b5 9e		      lda	eTop,x
    638  0564		       c5 ae		      cmp	temp+1
    639  0566		       90 0d		      bcc	.place
    640  0568		       d0 04		      bne	.shift
    641  056a		       e4 ad		      cpx	temp	; same event row: the lower enemy number first
    642  056c		       90 07		      bcc	.place
    643  056e				   .shift
    644  056e		       8a		      txa
    645  056f		       99 a8 00 	      sta	eOrder,y
    646  0572		       88		      dey
    647  0573		       d0 eb		      bne	.si
