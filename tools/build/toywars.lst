------- FILE toywars.asm
    883  0a5f
    884  0a5f							;-------------------------------------------------------------------------------
    885  0a5f							; F6 hotspots: an access to $FFF6/$FFF7/$FFF8/$FFF9 selects bank 0/1/2/3.
    886  0a5f							; A switch takes effect on the next fetch, at the same address in the new bank.
    887  0a5f							; Calls into bank 2: bank 0 switches, bank 2 (at the next address) does the
    888  0a5f							; JSR and switches back, and bank 0 returns.
    889  0fc0					      ORG	$0FC0
    890  0fc0					      RORG	$FFC0
    891  0fc0				   CallInit
    892  0fc0		       ad f8 ff 	      lda	$FFF8	; bank 2 runs $FFC3-$FFC8: jsr LogicInit, lda $FFF6
    893  0fc3		       ea ea ea ea*	      ds	6, $EA
    894  0fc9		       60		      rts		; $FFC9
    895  0fd0					      ORG	$0FD0
    896  0fd0					      RORG	$FFD0
    897  0fd0				   CallLogic
    898  0fd0		       ad f8 ff 	      lda	$FFF8	; bank 2 runs $FFD3-$FFD8: jsr Logic, lda $FFF6
    899  0fd3		       ea ea ea ea*	      ds	6, $EA
    900  0fd9		       60		      rts		; $FFD9
    901  0fda
    902  0fe0					      ORG	$0FE0
    903  0fe0					      RORG	$FFE0
    904  0fe0				   ToBank1
    905  0fe0		       ad f7 ff 	      lda	$FFF7	; bank 1 continues at $FFE3: jmp PreKernel
    906  0fe3		       ea		      nop
    907  0fe4		       ea		      nop
    908  0fe5		       ea		      nop
    909  0fe6		       ad f6 ff 	      lda	$FFF6	; ($FFE6) bank 1 switches here
    910  0fe9		       4c 9b f2 	      jmp	Overscan	; ($FFE9)
    911  0fec
    912  0ff0					      ORG	$0FF0
    913  0ff0					      RORG	$FFF0
    914  0ff0				   Reset0
    915  0ff0		       ad f6 ff 	      lda	$FFF6	; every bank's reset stub: the cartridge can
    916  0ff3		       4c 00 f1 	      jmp	Start0	; power up in any bank
    917  0ffa					      ORG	$0FFA
    918  0ffa					      RORG	$FFFA
    919  0ffa		       f0 ff f0 ff*	      .word.w	Reset0, Reset0, Reset0
    920  1000
    921  1000							;===============================================================================
    922  1000							; BANK 1
    923  1000							;===============================================================================
    924  2000 ????				      SEG	bank1
    925  1000					      ORG	$1000
    926  1000					      RORG	$F000
    927  1000		       00 00 00 00*	      ds	256, 0	; Super Chip RAM window
    928  1100
