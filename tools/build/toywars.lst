    525  04a7		       e6 ae		      inc	temp+1
    526  04a9		       e6 af		      inc	temp+2
    527  04ab		       88		      dey
    528  04ac		       10 e8		      bpl	.row
    529  04ae		       a6 b0		      ldx	temp+3
