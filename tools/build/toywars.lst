   1373  29e8							; Splash (odd frames): a cannonball's burst also hits every other monster on
   1374  29e8							; its shelf within SPLASH pixels of the one it hit; a jet's burst (bit 7 of
   1375  29e8							; splashN; no monster hit first) hits every monster on its shelf. One monster
   1376  29e8							; is checked a frame (five frames a burst), which keeps the frame time bounded
   1377  29e8				   Splash
   1378  29e8					      SUBROUTINE
   1379  29e8		       ad cb f0 	      lda	R_splashN
   1380  29eb		       f0 4e		      beq	.done
   1381  29ed		       85 b1		      sta	lt0
   1382  29ef		       29 0f		      and	#$0F
   1383  29f1		       aa		      tax
   1384  29f2		       ca		      dex		; X = the monster to check
   1385  29f3		       d0 04		      bne	.more
   1386  29f5		       a9 00		      lda	#0	; the last one: the burst is over
   1387  29f7		       f0 05		      beq	.store
   1388  29f9				   .more
   1389  29f9		       a5 b1		      lda	lt0
   1390  29fb		       38		      sec
   1391  29fc		       e9 01		      sbc	#1
   1392  29fe				   .store
   1393  29fe		       8d 4b f0 	      sta	W_splashN
   1394  2a01		       a5 b1		      lda	lt0
   1395  2a03		       4a		      lsr
   1396  2a04		       4a		      lsr
   1397  2a05		       4a		      lsr
   1398  2a06		       4a		      lsr
   1399  2a07		       85 b1		      sta	lt0	; the monster hit (8-15: a jet's burst)
   1400  2a09		       e4 b1		      cpx	lt0
   1401  2a0b		       f0 2e		      beq	.done	; (it took its hit already)
   1402  2a0d		       bd 8a f0 	      lda	R_eType,x
   1403  2a10		       f0 29		      beq	.done
   1404  2a12		       bd 85 f0 	      lda	R_eLane,x
   1405  2a15		       cd ca f0 	      cmp	R_splashL
   1406  2a18		       d0 21		      bne	.done	; (a flying jet's shelf is 4-6)
   1407  2a1a		       a5 b1		      lda	lt0
   1408  2a1c		       29 08		      and	#8
   1409  2a1e		       d0 16		      bne	.jet
   1410  2a20		       bd 80 f0 	      lda	R_eX,x
   1411  2a23		       38		      sec
   1412  2a24		       ed c9 f0 	      sbc	R_splashX
   1413  2a27		       b0 04		      bcs	.right
   1414  2a29		       49 ff		      eor	#$FF	; (carry clear: + 1 makes it positive)
   1415  2a2b		       69 01		      adc	#1
   1416  2a2d				   .right
   1417  2a2d		       c9 0d		      cmp	#SPLASH+1
   1418  2a2f		       b0 0a		      bcs	.done
   1419  2a31		       a9 03		      lda	#CANNON_DMG
   1420  2a33		       4c aa f4 	      jmp	Damage
   1421  2a36				   .jet
   1422  2a36		       a9 0a		      lda	#JET_DMG
   1423  2a38		       4c aa f4 	      jmp	Damage
   1424  2a3b				   .done
   1425  2a3b		       60		      rts
