     41 U00df ????				      SEG.U	vars
     42 U0080					      ORG	$80
     43 U0080		       00 00	   pc0	      ds	2	; defender copy pointers (columns 0-2)
     44 U0082		       00 00	   pc1	      ds	2
     45 U0084		       00 00	   pc2	      ds	2
     46 U0086		       00 00	   m1ptr      ds	2	; shot (ENAM1) pointer
     47 U0088		       00 00	   p1ptr      ds	2	; enemy graphics pointer
     48 U008a		       00 00	   p1col      ds	2	; enemy color pointer (ColArr + feet row)
     49 U008c		       00 00	   stVec      ds	2	; next static row routine
     50 U008e		       00	   nextEv     ds	1	; y of the next event row
     51 U008f		       00	   nextSt     ds	1	; y of the next static row
     52 U0090		       00 00 00 00*slotPtr    ds	9	; defender pointer (low byte) per lane*3+column
     53 U0099		       00 00 00    shotPtr    ds	3	; shot pointer (low byte) per lane
     54 U009c		       00	   frame      ds	1
     55 U009d		       00	   pfColor    ds	1	; shelves and box (flashes white on a lid slam or air strike)
     56 U009e							; scheduler scratch: SelectEnemies (overscan) fills it, Schedule (VBLANK) reads it
     57 U009e		       00 00 00 00*eTop       ds	NENEMY	; event row
     58 U00a3		       00 00 00 00*eFeet      ds	NENEMY	; feet row
     59 U00a8		       00 00 00 00*eOrder     ds	NENEMY	; sorted order, bit 7 = drawn this frame
     60 U00ad		       00 00 00 00 temp       ds	4
     61 U00b1		       00	   lt0	      ds	1	; game logic scratch (bank 2)
     62 U00b2		       00	   lt1	      ds	1
     63 U00b3		       00	   lt2	      ds	1
     64 U00b4		       00	   lt3	      ds	1
     65 U00b5		       00	   lt4	      ds	1
     66 U00b6		       00	   lt5	      ds	1
     67 U00b7		       00 00 00 00*QUEUE      ds	40	; event records, 8 bytes: return lo, hi, gfx lo, hi, feet, color page, HMP1, next y
     68 U00b7		       00 ff	   STACKTOP   =	$FF
     69 U00df
     70 U00df		       00 b0	   lineCnt    =	temp+3	; header loops
     71 U00df		       00 af	   evPrevF    =	temp+2	; scheduler
     72 U00df
 RAM used:  95  bytes (stack above)
     73 U00df					      echo	"RAM used: ", (QUEUE + 40 - $80)d, " bytes (stack above)"
     74 U00df
     75 U00df							; Super Chip RAM (cartridge, 128 bytes): write at W_name, read at R_name
     76 U00df							; ($80 higher). Game state that the kernel doesn't need lives here.
     77 Uf06e ????				      SEG.U	scram
     78 Uf000					      ORG	$F000
     79 Uf000		       00 00 00 00*W_eX       ds	NENEMY	; enemies: left x
     80 Uf005		       00 00 00 00*W_eLane    ds	NENEMY	;   shelf 0-2
     81 Uf00a		       00 00 00 00*W_eType    ds	NENEMY	;   0 none, 1 dino, 2 helicopter, 3 crawler
     82 Uf00f		       00 00 00 00*W_eHP      ds	NENEMY	;   health
     83 Uf014		       00 00 00 00*W_eState   ds	NENEMY	;   bit 7 chewing, bit 6 hopped, bits 0-5 lasso frames left
     84 Uf019		       00 00 00 00*W_slotType ds	9	; toys per slot (shelf*3+column): 0 none, 1-6 (TOY_*)
     85 Uf022		       00 00 00 00*W_slotHP   ds	9
     86 Uf02b		       00 00 00 00*W_slotCool ds	9	; visits (6 frames) until the toy acts again
     87 Uf034		       00	   W_toyShelf ds	1	; the shelf whose toys act next
     88 Uf035		       00 00 00    W_shotDmg  ds	3	; per shelf: damage of the shot in flight, 0 = none
     89 Uf038		       00 00 00    W_shotKind ds	3	;   1 = an army man's bullet (passes over a chewing crawler)
     90 Uf03b		       00 00 00    W_score    ds	3	; BCD, most significant first
     91 Uf03e		       00	   W_wave     ds	1	; binary, from 1
     92 Uf03f		       00	   W_batt     ds	1	; batteries, binary 0-99
     93 Uf040		       00	   W_battTimer ds	1
     94 Uf041		       00	   W_cursor   ds	1	; slot 0-8
     95 Uf042		       00	   W_toy      ds	1	; toy type chosen for placing
     96 Uf043		       00	   W_unlock   ds	1	; highest toy type unlocked
     97 Uf044		       00	   W_input    ds	1	; last frame's joystick (bits 3-0 right left down up) and fire (bit 7)
     98 Uf045		       00	   W_repeat   ds	1	; cursor auto-repeat countdown
     99 Uf046		       00	   W_fireState ds	1	; 1 = fire pressed (act on release), 2 = used to change toy
    100 Uf047		       00	   W_swPrev   ds	1	; Game Reset held last frame
    101 Uf048		       00	   W_lids     ds	1	; bits 0-2: shelf's lid slam used
    102 Uf049		       00	   W_state    ds	1	; 0 attract, 1 playing, 2 game over
    103 Uf04a		       00	   W_overTimer ds	1
    104 Uf04b		       00	   W_spawnLeft ds	1
    105 Uf04c		       00	   W_spawnTimer ds	1
    106 Uf04d		       00	   W_rand     ds	1
    107 Uf04e		       00	   W_flash    ds	1
    108 Uf04f		       00	   W_dirty    ds	1	; status line parts to rebuild: 1/8/16 score cells, 2 batteries, 4 wave
    109 Uf050		       00 00 00 00*W_cells    ds	30	; status line, 6 cells x 5 rows (bottom row first)
    110 Uf050		       f0 6e	   SC_END     =	.
    111 Uf050		       f0 80	   R_eX       =	W_eX + $80
    112 Uf050		       f0 85	   R_eLane    =	W_eLane + $80
