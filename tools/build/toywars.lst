    450  034f							;-------------------------------------------------------------------------------
    451  034f							; SelectEnemies (overscan, after Motion): decide which enemies player 1 draws
    452  034f							; next frame. Each enemy needs rows E-1 .. feet, where E is its event row (the
    453  034f							; first row at or above top-1 that the kernel allows) and E-1 is blank. They
    454  034f							; are sorted by E; one that overlaps an enemy already taken waits.
    455  034f				   SelectEnemies
    456  034f					      SUBROUTINE
    457  034f		       a2 04		      ldx	#NENEMY-1
    458  0351				   .tf
    459  0351		       8a		      txa
    460  0352		       95 a7		      sta	eOrder,x
    461  0354		       bd 8a f0 	      lda	R_eType,x
