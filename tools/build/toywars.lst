   1517  2ad4							; Music (every other frame): an 8-bar toy march, eighth notes of 12 frames. Before a
   1518  2ad4							; game and at game over: melody on channel 0 and bass on channel 1; during
   1519  2ad4							; play: the melody alone, softly. A sound effect on a channel always wins;
   1520  2ad4							; the music picks up again at its next note.
   1521  2ad4				   Music
   1522  2ad4					      SUBROUTINE
   1523  2ad4		       ad c2 f0 	      lda	R_musTimer
   1524  2ad7		       18		      clc
   1525  2ad8		       69 02		      adc	#2
   1526  2ada		       c9 0c		      cmp	#12
   1527  2adc		       90 0d		      bcc	.same
   1528  2ade		       ad c1 f0 	      lda	R_musPos
   1529  2ae1		       18		      clc
   1530  2ae2		       69 01		      adc	#1
   1531  2ae4		       29 3f		      and	#63
   1532  2ae6		       8d 41 f0 	      sta	W_musPos
   1533  2ae9		       a9 00		      lda	#0
   1534  2aeb				   .same
   1535  2aeb		       8d 42 f0 	      sta	W_musTimer
   1536  2aee							; melody, channel 0
   1537  2aee		       ad b9 f0 	      lda	R_sndPri
   1538  2af1		       d0 3d		      bne	.bass	; a sound effect has the channel
   1539  2af3		       ae c1 f0 	      ldx	R_musPos
   1540  2af6		       ad c2 f0 	      lda	R_musTimer
   1541  2af9		       d0 26		      bne	.melEnd
   1542  2afb		       bc 70 fb 	      ldy	MelNote,x	; start of an eighth
   1543  2afe		       c0 07		      cpy	#7
   1544  2b00		       f0 2e		      beq	.bass	; a tie: keep sounding
   1545  2b02		       a9 00		      lda	#0
   1546  2b04		       c0 00		      cpy	#0
   1547  2b06		       f0 14		      beq	.melVol	; a rest
   1548  2b08		       a9 04		      lda	#4
   1549  2b0a		       85 15		      sta	AUDC0
   1550  2b0c		       b9 b1 fb 	      lda	MelF,y
   1551  2b0f		       85 17		      sta	AUDF0
   1552  2b11		       a9 06		      lda	#6
   1553  2b13		       ac da f0 	      ldy	R_state
   1554  2b16		       c0 01		      cpy	#ST_PLAY
   1555  2b18		       d0 02		      bne	.melVol
   1556  2b1a		       a9 03		      lda	#3	; softer under the game
   1557  2b1c				   .melVol
   1558  2b1c		       85 19		      sta	AUDV0
   1559  2b1e		       4c 30 fb 	      jmp	.bass
   1560  2b21				   .melEnd
   1561  2b21		       c9 0a		      cmp	#10	; the last two frames: a short gap before the next note
   1562  2b23		       d0 0b		      bne	.bass
   1563  2b25		       bd 71 fb 	      lda	MelNote+1,x	; (MelNote has a 65th byte: the first again)
   1564  2b28		       c9 07		      cmp	#7
   1565  2b2a		       f0 04		      beq	.bass
   1566  2b2c		       a9 00		      lda	#0
   1567  2b2e		       85 19		      sta	AUDV0
   1568  2b30				   .bass
   1569  2b30							; bass, channel 1: only before a game and at game over
   1570  2b30		       ad ba f0 	      lda	R_sndPri+1
   1571  2b33		       d0 0b		      bne	.done
   1572  2b35		       ad da f0 	      lda	R_state
   1573  2b38		       c9 01		      cmp	#ST_PLAY
   1574  2b3a		       d0 05		      bne	.bassOn
   1575  2b3c		       a9 00		      lda	#0
   1576  2b3e		       85 1a		      sta	AUDV1
   1577  2b40				   .done
   1578  2b40		       60		      rts
   1579  2b41				   .bassOn
   1580  2b41		       ad c1 f0 	      lda	R_musPos
   1581  2b44		       4a		      lsr
   1582  2b45		       aa		      tax		; quarter note 0-31
   1583  2b46		       b0 1c		      bcs	.second	; the second eighth of the quarter
   1584  2b48		       ad c2 f0 	      lda	R_musTimer
   1585  2b4b		       d0 f3		      bne	.done
   1586  2b4d		       bc b8 fb 	      ldy	BassNote,x
   1587  2b50		       a9 00		      lda	#0
   1588  2b52		       c0 00		      cpy	#0
   1589  2b54		       f0 0b		      beq	.bassVol
   1590  2b56		       a9 0c		      lda	#12
   1591  2b58		       85 16		      sta	AUDC1
   1592  2b5a		       b9 d8 fb 	      lda	BassF,y
   1593  2b5d		       85 18		      sta	AUDF1
   1594  2b5f		       a9 05		      lda	#5
   1595  2b61				   .bassVol
   1596  2b61		       85 1a		      sta	AUDV1
   1597  2b63		       60		      rts
   1598  2b64				   .second
   1599  2b64		       ad c2 f0 	      lda	R_musTimer
   1600  2b67		       c9 06		      cmp	#6
   1601  2b69		       d0 d5		      bne	.done
   1602  2b6b		       a9 00		      lda	#0	; bass notes last an eighth and a half
   1603  2b6d		       85 1a		      sta	AUDV1
   1604  2b6f		       60		      rts
   1605  2b70
   1606  2b70							; the theme (original): melody in eighths, 1-6 = C5 D5 E5 G5 A5 C6, 7 = tie,
   1607  2b70							; 0 = rest; bass in quarters, 1-5 = F3 G3 A3 C4 E3
   1608  2b70		       01 01 03 04*MelNote    .byte.b	1,1,3,4,3,1,4,7, 5,5,4,3,2,3,1,7
   1609  2b80		       01 01 03 04*	      .byte.b	1,1,3,4,5,4,3,7, 2,3,2,1,2,7,7,0
   1610  2b90		       03 03 04 05*	      .byte.b	3,3,4,5,6,5,4,7, 5,4,3,2,3,4,3,7
   1611  2ba0		       01 01 03 04*	      .byte.b	1,1,3,4,5,6,5,4, 3,2,3,2,1,7,7,0
   1612  2bb0		       01		      .byte.b	1
   1613  2bb1		       00 1d 1a 17*MelF       .byte.b	0, 29, 26, 23, 19, 17, 14	; AUDC 4: C5 D5 E5 G5 A5 C6
   1614  2bb8		       04 02 04 02*BassNote   .byte.b	4,2,4,2, 1,4,2,4, 4,2,3,5, 2,2,2,2
   1615  2bc8		       04 03 01 02*	      .byte.b	4,3,1,2, 1,4,2,4, 4,3,1,2, 2,2,4,0
   1616  2bd8		       00 1d 1a 17*BassF      .byte.b	0, 29, 26, 23, 19, 31	; AUDC 12: F3 G3 A3 C4 E3
   1617  2bde
   1618  2bde							;-------------------------------------------------------------------------------
   1619  2bde							; Sound: channel 0 plays the player's actions and jingles, channel 1 combat.
   1620  2bde							; A sound is a list of steps (ticks of two frames, AUDC*16+AUDV, AUDF) ending
   1621  2bde							; in a zero; a new sound replaces the one playing on its channel unless that
   1622  2bde							; one matters more (SndPri).
