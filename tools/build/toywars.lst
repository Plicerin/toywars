   1645  2b8e							;-------------------------------------------------------------------------------
   1646  2b8e							; JetAct (X = a launched jet): four pixels right per update; every enemy on
   1647  2b8e							; its shelf takes 10 damage once the nose has passed its middle. The jet's
   1648  2b8e							; health byte (unused for a jet) marks the enemy slots it has hit, so each is
   1649  2b8e							; hit exactly once; at most two an update (the rest the next one), so a pack
   1650  2b8e							; bunched together never dies all in one frame.
   1651  2b8e				   JetAct
   1652  2b8e					      SUBROUTINE
   1653  2b8e		       86 b4		      stx	lt3
   1654  2b90		       bd 80 f0 	      lda	R_eX,x
   1655  2b93		       18		      clc
   1656  2b94		       69 0c		      adc	#12
   1657  2b96		       85 b1		      sta	lt0	; the nose after this step
   1658  2b98		       bd 85 f0 	      lda	R_eLane,x
   1659  2b9b		       29 03		      and	#3
   1660  2b9d		       85 b2		      sta	lt1
   1661  2b9f		       a9 02		      lda	#2
   1662  2ba1		       a4 b0		      ldy	KILLED
   1663  2ba3		       f0 02		      beq	.hits
   1664  2ba5		       a9 01		      lda	#1	; an enemy died this frame already: one hit
   1665  2ba7				   .hits
   1666  2ba7		       85 b6		      sta	lt5	; hits left this update
   1667  2ba9		       a0 04		      ldy	#NENEMY-1
   1668  2bab				   .loop
   1669  2bab		       b9 85 f0 	      lda	R_eLane,y	; (an empty slot's shelf is $FF, a jet's 4-6)
   1670  2bae		       c5 b2		      cmp	lt1
   1671  2bb0		       d0 2e		      bne	.next
   1672  2bb2		       b9 80 f0 	      lda	R_eX,y
   1673  2bb5		       18		      clc
   1674  2bb6		       69 04		      adc	#4
   1675  2bb8		       c5 b1		      cmp	lt0
   1676  2bba		       b0 24		      bcs	.next	; its middle is still ahead of the nose
   1677  2bbc		       a6 b4		      ldx	lt3
   1678  2bbe		       bd 8f f0 	      lda	R_eHP,x
   1679  2bc1		       39 db fc 	      and	KindBit,y	; (bits 0-4: enemy slots 0-4)
   1680  2bc4		       d0 1a		      bne	.next	; hit already
   1681  2bc6		       a5 b6		      lda	lt5
   1682  2bc8		       f0 16		      beq	.next	; two this update: the next one gets it
   1683  2bca		       c6 b6		      dec	lt5
   1684  2bcc		       bd 8f f0 	      lda	R_eHP,x
   1685  2bcf		       19 db fc 	      ora	KindBit,y
   1686  2bd2		       9d 0f f0 	      sta	W_eHP,x
   1687  2bd5		       84 b3		      sty	lt2
   1688  2bd7		       a6 b3		      ldx	lt2
   1689  2bd9		       a9 0a		      lda	#JET_DMG
   1690  2bdb		       20 0f f5 	      jsr	Damage
   1691  2bde		       a4 b3		      ldy	lt2
   1692  2be0				   .next
   1693  2be0		       88		      dey
   1694  2be1		       10 c8		      bpl	.loop
   1695  2be3		       a6 b4		      ldx	lt3
   1696  2be5		       bd 80 f0 	      lda	R_eX,x
   1697  2be8		       18		      clc
   1698  2be9		       69 04		      adc	#4
   1699  2beb		       c9 98		      cmp	#152
   1700  2bed		       b0 06		      bcs	.gone
   1701  2bef		       9d 00 f0 	      sta	W_eX,x
   1702  2bf2		       4c ca f8 	      jmp	EnemyRow
   1703  2bf5				   .gone
