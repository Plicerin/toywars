------- FILE logic.asm LEVEL 2 PASS 2
      0  2100					      include	"logic.asm"
      1  2100							; TOY WARS game logic (bank 2), included by toywars.asm.
      2  2100							;
      3  2100							; LogicInit runs once at power-on, Logic once per frame in overscan. Game
      4  2100							; state is in Super Chip RAM: read at R_name, written at W_name, so every
      5  2100							; change is load / modify / store (no INC/DEC on it). Toys and shots take
      6  2100							; turns: shots move on even frames, toys act on odd ones.
      7  2100
      8  2100		       00 01	   TOY_ARMY   =	1
      9  2100		       00 02	   TOY_TEDDY  =	2
     10  2100		       00 03	   TOY_TANK   =	3
     11  2100		       00 04	   TOY_JACK   =	4
     12  2100		       00 05	   TOY_CANNON =	5
     13  2100		       00 06	   TOY_JET    =	6
     14  2100		       00 01	   EN_DINO    =	1
     15  2100		       00 02	   EN_HELI    =	2
     16  2100		       00 03	   EN_CRAWL   =	3
     17  2100		       00 04	   EN_MOUSE   =	4
     18  2100		       00 05	   EN_KNIGHT  =	5
     19  2100		       00 06	   EN_BALLOON =	6
     20  2100		       00 07	   EN_POGO    =	7
     21  2100		       00 08	   EN_TREX    =	8
     22  2100		       00 09	   EN_JET     =	9	; a launched jet (drawn like an enemy, in green)
     23  2100		       00 09	   NKINDS     =	9	; (kind 0 = none; the jet has no pace entry)
     24  2100		       00 01	   SHOT_ARMY  =	1
     25  2100		       00 02	   SHOT_TANK  =	2
     26  2100		       00 03	   SHOT_CANNON =	3
     27  2100		       00 0c	   SPLASH     =	12	; a cannonball's splash reach, pixels each way
     28  2100		       00 03	   CANNON_DMG =	3
     29  2100		       00 0a	   JET_DMG    =	10
     30  2100		       00 b0	   KILLED     =	temp+3	; this frame an enemy died (overscan only: VBLANK
     31  2100							;   uses temp for the status line)
     32  2100		       00 0a	   JACK_DMG   =	10	; a jack-in-the-box's spring: damage to each enemy
     33  2100		       00 08	   JACK_REACH =	8	;   within this many pixels of the box's middle,
     34  2100		       00 18	   JACK_THROW =	24	;   thrown this many pixels back up the shelf
     35  2100		       00 f0	   TRICKLE    =	240	; frames per battery (one byte: at most 255)
     36  2100		       00 01	   A_LAP2_HP  =	1	; extra health for every enemy in the second lap on difficulty A
     37  2100		       00 96	   TRICKLE2   =	150	;   in the second lap (2.5 s)
     38  2100		       00 00	   ST_ATTRACT =	0
     39  2100		       00 01	   ST_PLAY    =	1
     40  2100		       00 02	   ST_OVER    =	2
     41  2100		       00 0e	   COL_WHITE  =	$0E
     42  2100		       00 29	   BREACH_X   =	41	; an enemy left of this is at the toy box
     43  2100		       00 28	   JET_X0     =	BREACH_X - 1	; where a jet takes off
     44  2100
     45  2100							; sound effects (ids into SndStart/SndChan/SndPri)
     46  2100		       00 00	   SND_CURSOR =	0
     47  2100		       00 01	   SND_SELECT =	1
     48  2100		       00 02	   SND_PLACE  =	2
     49  2100		       00 03	   SND_PICK   =	3
