    617  0590							; the pips: PF2 per font row (bottom first) x 4 levels; three dashes, and as
    618  0590							; many blocks on them as the level (bits 2, 4, 6: x 136, 144, 152)
    619  0590		       00 00 00 00 PipRow     .byte.b	0, 0, 0, 0
    620  0594		       00 54 54 54	      .byte.b	0, $54, $54, $54
    621  0598		       00 04 14 54	      .byte.b	0, $04, $14, $54
    622  059c		       00 04 14 54	      .byte.b	0, $04, $14, $54
    623  05a0		       00 00 00 00	      .byte.b	0, 0, 0, 0
    624  05a4							; (PipLevel / PipBase, the pips per toy and health: gen.mjs, from ToyHP)
    625  05a4
    626  05a4				   TwoDigits		; X = 0-99 -> temp = tens*5, temp+1 = ones*5
    627  05a4		       bd 7b f9 	      lda	Bin2BCD,x
    628  05a7		       4a		      lsr
    629  05a8		       4a		      lsr
    630  05a9		       4a		      lsr
    631  05aa		       4a		      lsr
