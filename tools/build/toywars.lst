   1380  2a0b							;-------------------------------------------------------------------------------
   1381  2a0b							; Music (odd frames): an 8-bar toy march, eighth notes of 12 frames. Before a
   1382  2a0b							; game and at game over: melody on channel 0 and bass on channel 1; during
   1383  2a0b							; play: the melody alone, softly. A sound effect on a channel always wins;
   1384  2a0b							; the music picks up again at its next note.
   1385  2a0b				   Music
   1386  2a0b					      SUBROUTINE
   1387  2a0b		       ad c2 f0 	      lda	R_musTimer
   1388  2a0e		       18		      clc
   1389  2a0f		       69 02		      adc	#2
   1390  2a11		       c9 0c		      cmp	#12
   1391  2a13		       90 0d		      bcc	.same
   1392  2a15		       ad c1 f0 	      lda	R_musPos
   1393  2a18		       18		      clc
   1394  2a19		       69 01		      adc	#1
   1395  2a1b		       29 3f		      and	#63
   1396  2a1d		       8d 41 f0 	      sta	W_musPos
   1397  2a20		       a9 00		      lda	#0
   1398  2a22				   .same
   1399  2a22		       8d 42 f0 	      sta	W_musTimer
   1400  2a25							; melody, channel 0
   1401  2a25		       ad b9 f0 	      lda	R_sndPri
   1402  2a28		       d0 3d		      bne	.bass	; a sound effect has the channel
   1403  2a2a		       ae c1 f0 	      ldx	R_musPos
   1404  2a2d		       ad c2 f0 	      lda	R_musTimer
   1405  2a30		       d0 26		      bne	.melEnd
   1406  2a32		       bc a7 fa 	      ldy	MelNote,x	; start of an eighth
   1407  2a35		       c0 07		      cpy	#7
   1408  2a37		       f0 2e		      beq	.bass	; a tie: keep sounding
   1409  2a39		       a9 00		      lda	#0
   1410  2a3b		       c0 00		      cpy	#0
   1411  2a3d		       f0 14		      beq	.melVol	; a rest
   1412  2a3f		       a9 04		      lda	#4
   1413  2a41		       85 15		      sta	AUDC0
   1414  2a43		       b9 e8 fa 	      lda	MelF,y
   1415  2a46		       85 17		      sta	AUDF0
   1416  2a48		       a9 06		      lda	#6
   1417  2a4a		       ac d7 f0 	      ldy	R_state
   1418  2a4d		       c0 01		      cpy	#ST_PLAY
   1419  2a4f		       d0 02		      bne	.melVol
   1420  2a51		       a9 03		      lda	#3	; softer under the game
   1421  2a53				   .melVol
   1422  2a53		       85 19		      sta	AUDV0
   1423  2a55		       4c 67 fa 	      jmp	.bass
   1424  2a58				   .melEnd
   1425  2a58		       c9 0a		      cmp	#10	; the last two frames: a short gap before the next note
   1426  2a5a		       d0 0b		      bne	.bass
   1427  2a5c		       bd a8 fa 	      lda	MelNote+1,x	; (MelNote has a 65th byte: the first again)
   1428  2a5f		       c9 07		      cmp	#7
   1429  2a61		       f0 04		      beq	.bass
   1430  2a63		       a9 00		      lda	#0
   1431  2a65		       85 19		      sta	AUDV0
   1432  2a67				   .bass
   1433  2a67							; bass, channel 1: only before a game and at game over
   1434  2a67		       ad ba f0 	      lda	R_sndPri+1
   1435  2a6a		       d0 0b		      bne	.done
   1436  2a6c		       ad d7 f0 	      lda	R_state
   1437  2a6f		       c9 01		      cmp	#ST_PLAY
   1438  2a71		       d0 05		      bne	.bassOn
   1439  2a73		       a9 00		      lda	#0
   1440  2a75		       85 1a		      sta	AUDV1
   1441  2a77				   .done
   1442  2a77		       60		      rts
   1443  2a78				   .bassOn
   1444  2a78		       ad c1 f0 	      lda	R_musPos
   1445  2a7b		       4a		      lsr
   1446  2a7c		       aa		      tax		; quarter note 0-31
   1447  2a7d		       b0 1c		      bcs	.second	; the second eighth of the quarter
   1448  2a7f		       ad c2 f0 	      lda	R_musTimer
   1449  2a82		       d0 f3		      bne	.done
   1450  2a84		       bc ef fa 	      ldy	BassNote,x
   1451  2a87		       a9 00		      lda	#0
   1452  2a89		       c0 00		      cpy	#0
   1453  2a8b		       f0 0b		      beq	.bassVol
   1454  2a8d		       a9 0c		      lda	#12
   1455  2a8f		       85 16		      sta	AUDC1
   1456  2a91		       b9 0f fb 	      lda	BassF,y
   1457  2a94		       85 18		      sta	AUDF1
   1458  2a96		       a9 05		      lda	#5
   1459  2a98				   .bassVol
   1460  2a98		       85 1a		      sta	AUDV1
   1461  2a9a		       60		      rts
   1462  2a9b				   .second
   1463  2a9b		       ad c2 f0 	      lda	R_musTimer
