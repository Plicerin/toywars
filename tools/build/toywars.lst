   1546  2aee		       8e 4a f0 	      stx	W_splashL
   1547  2af1		       98		      tya
   1548  2af2		       0a		      asl
   1549  2af3		       0a		      asl
   1550  2af4		       0a		      asl
   1551  2af5		       0a		      asl
   1552  2af6		       09 05		      ora	#NENEMY
   1553  2af8		       8d 4b f0 	      sta	W_splashN
