    519  0498		       bd 54 f8 	      lda	DigitHi,x
    520  049b		       a6 ae		      ldx	temp+1
    521  049d		       1d 86 f8 	      ora	DigitLo,x
    522  04a0		       a6 af		      ldx	temp+2
