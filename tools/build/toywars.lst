     51  2100		       00 05	   SND_WAVE   =	5
     52  2100		       00 06	   SND_OVER   =	6
     53  2100		       00 07	   SND_POP    =	7
     54  2100		       00 08	   SND_BOOM   =	8
     55  2100		       00 09	   SND_THUMP  =	9
     56  2100		       00 0a	   SND_SPRING =	10
     57  2100		       00 0b	   SND_HIT    =	11
     58  2100		       00 0c	   SND_KILL   =	12
     59  2100		       00 0d	   SND_CHEW   =	13
     60  2100		       00 0e	   SND_SLAM   =	14
     61  2100		       00 0f	   SND_JET    =	15
