------- FILE toywars.asm LEVEL 1 PASS 2
      1  4000 ????						; TOY WARS -- lane defense on the toy shelves (Atari 2600, 16K F6, NTSC)
      2  4000 ????						;
      3  4000 ????						; Milestone 1: the still screen. Three slanted shelves (the ball, moved six
      4  4000 ????						; pixels left every row by HMOVE), the toy box (playfield 1, cleared mid-line
      5  4000 ????						; so its reflected copy never shows), green toy defenders on a 3 x 3 grid
      6  4000 ????						; (player 0 as three copies 32 pixels apart, graphics rewritten between the
      7  4000 ????						; copies), red enemies (player 1, moved from enemy to enemy down the screen),
      8  4000 ????						; and the defenders' shots (missile 1).
      9  4000 ????						;
     10  4000 ????						; Bank 0: frame loop, game logic, the event scheduler, the header (title and
     11  4000 ????						; status line, 48-pixel text). Bank 1: the play kernel and its graphics.
     12  4000 ????						; Bank 2: game logic (logic.asm). Bank 3: free (reset stub only).
     13  4000 ????						;
     14  4000 ????						; Frame: 3 VSYNC + 37 VBLANK + 192 visible + 30 overscan = 262 lines.
     15  4000 ????						; Visible: s0 blank, s1-14 title, s15 setup, s16-25 status, s26-28
     16  4000 ????						; positioning, s29 blank, s30 rule, s31 setup, s32-191 play area (80 x 2).
     17  4000 ????						;
     18  4000 ????						; Play kernel: rows y = 79..0 (top to bottom), two lines each. Line A: HMOVE,
     19  4000 ????						; box, shelf, shot, the three defender copies. Line B: box, defenders, enemy
     20  4000 ????						; graphics and color, and the checks for the next special row:
     21  4000 ????						;  - event rows (from a queue built in bank 0, pulled with PLA; RTS jumps to
     22  4000 ????						;    one of eight variants that strobe RESP1 at a fixed cycle) move player 1
     23  4000 ????						;    to the next enemy;
     24  4000 ????						;  - static rows (fixed, via JMP (stVec)) swap the defender pointers to the
     25  4000 ????						;    next lane, restart the ball and the shot missile on the next shelf, and
     26  4000 ????						;    end the kernel.
     27  4000 ????
     28  4000 ????				      processor	6502
------- FILE vcs.h LEVEL 2 PASS 2
      0  4000 ????				      include	vcs.h
      1  4000 ????						; VCS.H
      2  4000 ????						; Version 1.07, 08/OCT/2021
      3  4000 ????
      4  4000 ????	       00 6b	   VERSION_VCS =	107
      5  4000 ????
      6  4000 ????						; THIS IS *THE* "STANDARD" VCS.H
      7  4000 ????						; THIS FILE IS EXPLICITLY SUPPORTED AS A DASM-PREFERRED COMPANION FILE
      8  4000 ????						; The latest version can be found at https://dasm-assembler.github.io/
      9  4000 ????						;
     10  4000 ????						; This file defines hardware registers and memory mapping for the
     11  4000 ????						; Atari 2600. It is distributed as a companion machine-specific support package
     12  4000 ????						; for the DASM compiler. Updates to this file, DASM, and associated tools are
     13  4000 ????						; available at at https://dasm-assembler.github.io/
     14  4000 ????						;
     15  4000 ????						; Many thanks to the people who have contributed. If you find an issue with the
     16  4000 ????						; contents, or would like to add something, please report as an issue at...
     17  4000 ????						; https://github.com/dasm-assembler/dasm/issues
     18  4000 ????
     19  4000 ????						;
     20  4000 ????						; Latest Revisions...
     21  4000 ????						; 1.07  08/OCT/2021	 Added timer interrupt registers
     22  4000 ????						; 1.06  05/SEP/2020	 Modified header/license and links to new versions
     23  4000 ????						; 1.05  13/NOV/2003	  - Correction to 1.04 - now functions as requested by MR.
     24  4000 ????						;			  - Added VERSION_VCS equate (which will reflect 100x version #)
     25  4000 ????						;			    This will allow conditional code to verify VCS.H being
     26  4000 ????						;			    used for code assembly.
     27  4000 ????						; 1.04  12/NOV/2003	 Added TIA_BASE_WRITE_ADDRESS and TIA_BASE_READ_ADDRESS for
     28  4000 ????						;			 convenient disassembly/reassembly compatibility for hardware
     29  4000 ????						;			 mirrored reading/writing differences.	This is more a
     30  4000 ????						;			 readability issue, and binary compatibility with disassembled
     31  4000 ????						;			 and reassembled sources.  Per Manuel Rotschkar's suggestion.
     32  4000 ????						; 1.03  12/MAY/2003	 Added SEG segment at end of file to fix old-code compatibility
     33  4000 ????						;			 which was broken by the use of segments in this file, as
     34  4000 ????						;			 reported by Manuel Polik on [stella] 11/MAY/2003
     35  4000 ????						; 1.02  22/MAR/2003	 Added TIMINT($285)
     36  4000 ????						; 1.01 		 Constant offset added to allow use for 3F-style bankswitching
     37  4000 ????						;			  - define TIA_BASE_ADDRESS as $40 for Tigervision carts, otherwise
     38  4000 ????						;			    it is safe to leave it undefined, and the base address will
     39  4000 ????						;			    be set to 0.  Thanks to Eckhard Stolberg for the suggestion.
     40  4000 ????						;			    Note, may use -DLABEL=EXPRESSION to define TIA_BASE_ADDRESS
     41  4000 ????						;			  - register definitions are now generated through assignment
     42  4000 ????						;			    in uninitialised segments.	This allows a changeable base
     43  4000 ????						;			    address architecture.
     44  4000 ????						; 1.0	 22/MAR/2003	 Initial release
     45  4000 ????
     46  4000 ????
     47  4000 ????						;-------------------------------------------------------------------------------
     48  4000 ????
     49  4000 ????						; TIA_BASE_ADDRESS
     50  4000 ????						; The TIA_BASE_ADDRESS defines the base address of access to TIA registers.
     51  4000 ????						; Normally 0, the base address should (externally, before including this file)
     52  4000 ????						; be set to $40 when creating 3F-bankswitched (and other?) cartridges.
     53  4000 ????						; The reason is that this bankswitching scheme treats any access to locations
     54  4000 ????						; < $40 as a bankswitch.
     55  4000 ????
     56  4000 ????			  -	      IFNCONST	TIA_BASE_ADDRESS
     57  4000 ????			  -TIA_BASE_ADDRESS =	0
     58  4000 ????				      ENDIF
     59  4000 ????
     60  4000 ????						; Note: The address may be defined on the command-line using the -D switch, eg:
     61  4000 ????						; dasm.exe code.asm -DTIA_BASE_ADDRESS=$40 -f3 -v5 -ocode.bin
     62  4000 ????						; *OR* by declaring the label before including this file, eg:
     63  4000 ????						; TIA_BASE_ADDRESS = $40
     64  4000 ????						;   include "vcs.h"
     65  4000 ????
     66  4000 ????						; Alternate read/write address capability - allows for some disassembly compatibility
     67  4000 ????						; usage ; to allow reassembly to binary perfect copies).  This is essentially catering
     68  4000 ????						; for the mirrored ROM hardware registers.
     69  4000 ????
     70  4000 ????						; Usage: As per above, define the TIA_BASE_READ_ADDRESS and/or TIA_BASE_WRITE_ADDRESS
     71  4000 ????						; using the -D command-line switch, as required.  If the addresses are not defined,
     72  4000 ????						; they defaut to the TIA_BASE_ADDRESS.
     73  4000 ????
     74  4000 ????			  -	      IFNCONST	TIA_BASE_READ_ADDRESS
     75  4000 ????			  -TIA_BASE_READ_ADDRESS =	TIA_BASE_ADDRESS
     76  4000 ????				      ENDIF
     77  4000 ????
     78  4000 ????			  -	      IFNCONST	TIA_BASE_WRITE_ADDRESS
     79  4000 ????			  -TIA_BASE_WRITE_ADDRESS =	TIA_BASE_ADDRESS
     80  4000 ????				      ENDIF
     81  4000 ????
     82  4000 ????						;-------------------------------------------------------------------------------
     83  4000 ????
     84 U002d ????				      SEG.U	TIA_REGISTERS_WRITE
     85 U0000					      ORG	TIA_BASE_WRITE_ADDRESS
