    698  05c1		       a5 ba		      lda	QUEUE
    699  05c3		       c5 ad		      cmp	temp
    700  05c5		       b0 2c		      bcs	.reject	; the last one taken ends at or below it
    701  05c7				   .noPrev
    702  05c7		       a5 bd		      lda	QUEUE+3
    703  05c9		       f0 0a		      beq	.take
    704  05cb		       b9 a3 00 	      lda	eFeet,y
    705  05ce		       18		      clc
