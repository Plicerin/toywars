     28  2100		       00 01	   ST_PLAY    =	1
     29  2100		       00 02	   ST_OVER    =	2
     30  2100		       00 0e	   COL_WHITE  =	$0E
     31  2100		       00 29	   BREACH_X   =	41	; an enemy left of this is at the toy box
     32  2100
