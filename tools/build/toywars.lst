   1724  2c0a		       b9 45 fc 	      lda	SndPri,y
   1725  2c0d		       dd b9 f0 	      cmp	R_sndPri,x
   1726  2c10		       90 0e		      bcc	.done	; something more important is playing
   1727  2c12		       9d 39 f0 	      sta	W_sndPri,x
   1728  2c15		       b9 25 fc 	      lda	SndStart,y
   1729  2c18		       9d 35 f0 	      sta	W_sndPos,x
   1730  2c1b		       a9 00		      lda	#0
   1731  2c1d		       9d 37 f0 	      sta	W_sndTimer,x
   1732  2c20				   .done
   1733  2c20		       a6 b7		      ldx	sndX
   1734  2c22		       a4 b8		      ldy	sndY
   1735  2c24		       60		      rts
   1736  2c25
