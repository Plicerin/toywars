   1735  2c1d		       b9 58 fc 	      lda	SndPri,y
   1736  2c20		       dd b9 f0 	      cmp	R_sndPri,x
   1737  2c23		       90 0e		      bcc	.done	; something more important is playing
   1738  2c25		       9d 39 f0 	      sta	W_sndPri,x
   1739  2c28		       b9 38 fc 	      lda	SndStart,y
   1740  2c2b		       9d 35 f0 	      sta	W_sndPos,x
