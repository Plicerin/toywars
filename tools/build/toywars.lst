   1579  2b22		       b9 80 f0 	      lda	R_eX,y
   1580  2b25		       18		      clc
   1581  2b26		       69 07		      adc	#7
   1582  2b28		       c5 b1		      cmp	lt0
   1583  2b2a		       90 64		      bcc	.next	; enemy ends left of the shot
   1584  2b2c		       bd c6 f0 	      lda	R_shotKind,x
   1585  2b2f		       c9 02		      cmp	#SHOT_TANK
   1586  2b31		       d0 09		      bne	.notShell
   1587  2b33		       b9 8a f0 	      lda	R_eType,y
   1588  2b36		       c9 06		      cmp	#EN_BALLOON
   1589  2b38		       f0 56		      beq	.next	; tank shells can't hit the balloon clown
   1590  2b3a		       d0 10		      bne	.hit
   1591  2b3c				   .notShell
   1592  2b3c		       c9 01		      cmp	#SHOT_ARMY
   1593  2b3e		       d0 0c		      bne	.hit
   1594  2b40		       b9 8a f0 	      lda	R_eType,y
   1595  2b43		       c9 03		      cmp	#EN_CRAWL
   1596  2b45		       d0 05		      bne	.hit
   1597  2b47		       b9 94 f0 	      lda	R_eState,y
   1598  2b4a		       30 44		      bmi	.next	; bullets pass over a crawler that is chewing
   1599  2b4c				   .hit
   1600  2b4c		       bd c6 f0 	      lda	R_shotKind,x
   1601  2b4f		       c9 03		      cmp	#SHOT_CANNON
   1602  2b51		       d0 22		      bne	.direct
