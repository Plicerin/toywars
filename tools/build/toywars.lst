------- FILE toywars.asm
    964  0c56
    965  0c56							;-------------------------------------------------------------------------------
    966  0c56							; F6 hotspots: an access to $FFF6/$FFF7/$FFF8/$FFF9 selects bank 0/1/2/3.
    967  0c56							; A switch takes effect on the next fetch, at the same address in the new bank.
    968  0c56							; Calls into bank 2: bank 0 switches, bank 2 (at the next address) does the
    969  0c56							; JSR and switches back, and bank 0 returns.
    970  0fb0					      ORG	$0FB0
    971  0fb0					      RORG	$FFB0
    972  0fb0				   CallSound
    973  0fb0		       ad f9 ff 	      lda	$FFF9	; bank 3 runs $FFB3-$FFB8: jsr Sound, lda $FFF6
    974  0fb3		       ea ea ea ea*	      ds	6, $EA
    975  0fb9		       60		      rts		; $FFB9
    976  0fc0					      ORG	$0FC0
    977  0fc0					      RORG	$FFC0
    978  0fc0				   CallInit
    979  0fc0		       ad f8 ff 	      lda	$FFF8	; bank 2 runs $FFC3-$FFC8: jsr LogicInit, lda $FFF6
    980  0fc3		       ea ea ea ea*	      ds	6, $EA
    981  0fc9		       60		      rts		; $FFC9
    982  0fd0					      ORG	$0FD0
    983  0fd0					      RORG	$FFD0
    984  0fd0				   CallLogic
    985  0fd0		       ad f8 ff 	      lda	$FFF8	; bank 2 runs $FFD3-$FFD8: jsr Logic, lda $FFF6
    986  0fd3		       ea ea ea ea*	      ds	6, $EA
    987  0fd9		       60		      rts		; $FFD9
    988  0fda
    989  0fe0					      ORG	$0FE0
    990  0fe0					      RORG	$FFE0
    991  0fe0				   ToBank1
    992  0fe0		       ad f7 ff 	      lda	$FFF7	; bank 1 continues at $FFE3: jmp PreKernel
    993  0fe3		       ea		      nop
    994  0fe4		       ea		      nop
    995  0fe5		       ea		      nop
    996  0fe6		       ad f6 ff 	      lda	$FFF6	; ($FFE6) bank 1 switches here
    997  0fe9		       4c 76 f4 	      jmp	Overscan	; ($FFE9)
    998  0fec
    999  0ff0					      ORG	$0FF0
   1000  0ff0					      RORG	$FFF0
   1001  0ff0				   Reset0
   1002  0ff0		       ad f6 ff 	      lda	$FFF6	; every bank's reset stub: the cartridge can
   1003  0ff3		       4c 00 f1 	      jmp	Start0	; power up in any bank
   1004  0ffa					      ORG	$0FFA
   1005  0ffa					      RORG	$FFFA
   1006  0ffa		       f0 ff f0 ff*	      .word.w	Reset0, Reset0, Reset0
   1007  1000
   1008  1000							;===============================================================================
   1009  1000							; BANK 1
   1010  1000							;===============================================================================
   1011  2000 ????				      SEG	bank1
   1012  1000					      ORG	$1000
   1013  1000					      RORG	$F000
   1014  1000		       00 00 00 00*	      ds	256, 0	; Super Chip RAM window
   1015  1100
