     29  2107		       8d 49 f0 	      sta	W_state
     30  210a		       20 83 f1 	      jsr	ClearBoard
     31  210d		       a9 07		      lda	#7
     32  210f		       8d 4f f0 	      sta	W_dirty
     33  2112		       4c 7d f1 	      jmp	Finish
     34  2115
     35  2115							;-------------------------------------------------------------------------------
     36  2115				   Logic
     37  2115					      SUBROUTINE
     38  2115		       20 30 f2 	      jsr	Random
