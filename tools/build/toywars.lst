    679  0846
    680  0846							;-------------------------------------------------------------------------------
    681  0846							; F6 hotspots: an access to $FFF6/$FFF7/$FFF8/$FFF9 selects bank 0/1/2/3.
    682  0846							; A switch takes effect on the next fetch, at the same address in the new bank.
    683  0fe0					      ORG	$0FE0
    684  0fe0					      RORG	$FFE0
    685  0fe0				   ToBank1
    686  0fe0		       ad f7 ff 	      lda	$FFF7	; bank 1 continues at $FFE3: jmp PreKernel
    687  0fe3		       ea		      nop
    688  0fe4		       ea		      nop
    689  0fe5		       ea		      nop
    690  0fe6		       ad f6 ff 	      lda	$FFF6	; ($FFE6) bank 1 switches here
    691  0fe9		       4c 47 f2 	      jmp	Overscan	; ($FFE9)
    692  0fec
    693  0ff0					      ORG	$0FF0
    694  0ff0					      RORG	$FFF0
    695  0ff0				   Reset0
    696  0ff0		       ad f6 ff 	      lda	$FFF6	; every bank's reset stub: the cartridge can
    697  0ff3		       4c 00 f1 	      jmp	Start0	; power up in any bank
    698  0ffa					      ORG	$0FFA
    699  0ffa					      RORG	$FFFA
    700  0ffa		       f0 ff f0 ff*	      .word.w	Reset0, Reset0, Reset0
    701  1000
    702  1000							;===============================================================================
    703  1000							; BANK 1
    704  1000							;===============================================================================
    705  2000 ????				      SEG	bank1
    706  1000					      ORG	$1000
    707  1000					      RORG	$F000
    708  1000		       00 00 00 00*	      ds	256, 0	; Super Chip RAM window
