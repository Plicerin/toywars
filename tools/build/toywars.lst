    608  0545							;-------------------------------------------------------------------------------
    609  0545							; SelectEnemies (VBLANK): decide which enemies player 1 draws this frame. Each enemy needs rows E-1 .. feet, where E is its event row (the
    610  0545							; first row at or above top-1 that the kernel allows) and E-1 is blank. They
    611  0545							; are sorted by E; one that overlaps an enemy already taken waits.
    612  0545				   SelectEnemies
    613  0545					      SUBROUTINE
    614  0545		       a2 04		      ldx	#NENEMY-1	; (eFeet/eTop come from EnemyRows in bank 2)
    615  0547				   .clear
    616  0547		       b5 a8		      lda	eOrder,x	; forget last frame's choice, keep the order
    617  0549		       29 7f		      and	#$7F
    618  054b		       95 a8		      sta	eOrder,x
    619  054d		       ca		      dex
    620  054e		       10 f7		      bpl	.clear
    621  0550							; insertion sort of eOrder by eTop (nearly sorted already: cheap)
    622  0550		       a2 01		      ldx	#1
    623  0552				   .so
    624  0552		       86 b0		      stx	temp+3
    625  0554		       b5 a8		      lda	eOrder,x
    626  0556		       85 ad		      sta	temp
    627  0558		       a8		      tay
    628  0559		       b9 9e 00 	      lda	eTop,y
    629  055c		       85 ae		      sta	temp+1
    630  055e		       a4 b0		      ldy	temp+3
    631  0560				   .si
    632  0560		       b6 a7		      ldx	eOrder-1,y
    633  0562		       b5 9e		      lda	eTop,x
    634  0564		       c5 ae		      cmp	temp+1
    635  0566		       90 0d		      bcc	.place
    636  0568		       d0 04		      bne	.shift
    637  056a		       e4 ad		      cpx	temp	; same event row: the lower enemy number first
    638  056c		       90 07		      bcc	.place
    639  056e				   .shift
    640  056e		       8a		      txa
    641  056f		       99 a8 00 	      sta	eOrder,y
    642  0572		       88		      dey
    643  0573		       d0 eb		      bne	.si
    644  0575				   .place
    645  0575		       a5 ad		      lda	temp
    646  0577		       99 a8 00 	      sta	eOrder,y
    647  057a		       a6 b0		      ldx	temp+3
    648  057c		       e8		      inx
    649  057d		       e0 05		      cpx	#NENEMY
    650  057f		       d0 d1		      bne	.so
    651  0581							; choose: walk the sorted list from position (frame & 7) mod n, wrapping,
    652  0581							; and take each enemy whose rows (event row - 1 .. feet) miss every enemy
    653  0581							; taken so far. The start moves every frame, so overlapping ones take turns.
    654  0581		       a2 00		      ldx	#0
    655  0583				   .count
    656  0583		       b4 a8		      ldy	eOrder,x
    657  0585		       b9 9e 00 	      lda	eTop,y
    658  0588		       c9 ff		      cmp	#$FF
    659  058a		       f0 05		      beq	.counted
    660  058c		       e8		      inx
    661  058d		       e0 05		      cpx	#NENEMY
    662  058f		       d0 f2		      bne	.count
    663  0591				   .counted
    664  0591		       86 b0		      stx	temp+3	; n
    665  0593		       8a		      txa
    666  0594		       f0 73		      beq	.selDone
    667  0596		       85 ae		      sta	temp+1	; candidates left
    668  0598		       a5 9c		      lda	frame
    669  059a		       29 07		      and	#7	; start: (frame & 7) mod n, so it visits every position
    670  059c		       38		      sec
    671  059d				   .mod
    672  059d		       e5 b0		      sbc	temp+3
    673  059f		       b0 fc		      bcs	.mod
    674  05a1		       65 b0		      adc	temp+3
    675  05a3		       85 af		      sta	temp+2
    676  05a5							;   The list is sorted by event row, so within each run (start..n-1, then
    677  05a5							;   0..start-1) a candidate can only overlap the last enemy taken in that
    678  05a5							;   run; in the second run it must also end above the first enemy taken in
    679  05a5							;   the first. QUEUE+0..3 (free until Schedule): last taken feet, any taken
    680  05a5							;   in this run, first run's first event row, in the second run.
    681  05a5		       a9 00		      lda	#0
    682  05a7		       85 bb		      sta	QUEUE+1
    683  05a9		       85 bd		      sta	QUEUE+3
    684  05ab		       a9 ff		      lda	#$FF
    685  05ad		       85 bc		      sta	QUEUE+2
    686  05af				   .cand
    687  05af		       a6 af		      ldx	temp+2
    688  05b1		       b4 a8		      ldy	eOrder,x
    689  05b3		       b9 9e 00 	      lda	eTop,y
    690  05b6		       f0 3b		      beq	.reject	; no usable event row
    691  05b8		       38		      sec
    692  05b9		       e9 01		      sbc	#1
    693  05bb		       85 ad		      sta	temp	; candidate event row - 1
    694  05bd		       a5 bb		      lda	QUEUE+1
    695  05bf		       f0 06		      beq	.noPrev
    696  05c1		       a5 ba		      lda	QUEUE
    697  05c3		       c5 ad		      cmp	temp
    698  05c5		       b0 2c		      bcs	.reject	; the last one taken ends at or below it
    699  05c7				   .noPrev
    700  05c7		       a5 bd		      lda	QUEUE+3
    701  05c9		       f0 0a		      beq	.take
    702  05cb		       b9 a3 00 	      lda	eFeet,y
    703  05ce		       18		      clc
    704  05cf		       69 01		      adc	#1
    705  05d1		       c5 bc		      cmp	QUEUE+2
    706  05d3		       b0 1e		      bcs	.reject	; second run: must end above the first run's first
    707  05d5				   .take
