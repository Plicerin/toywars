    621  0597							; the pips: PF2 per font row (bottom first) x 4 levels; three dashes, and as
    622  0597							; many blocks on them as the level (bits 2, 4, 6: x 136, 144, 152)
    623  0597		       00 00 00 00 PipRow     .byte.b	0, 0, 0, 0
    624  059b		       00 54 54 54	      .byte.b	0, $54, $54, $54
    625  059f		       00 04 14 54	      .byte.b	0, $04, $14, $54
    626  05a3		       00 04 14 54	      .byte.b	0, $04, $14, $54
    627  05a7		       00 00 00 00	      .byte.b	0, 0, 0, 0
    628  05ab							; a toy's health from which it shows 2 and 3 pips: max / 3 + 1, 2 max / 3 + 1
    629  05ab							; (logic.asm ToyHP: army 8, teddy 40, tank 12, jack 8, cannon 10)
    630  05ab		       00 03 0e 05*PipT1      .byte.b	0, 3, 14, 5, 3, 4, 0
    631  05b2		       00 06 1b 09*PipT2      .byte.b	0, 6, 27, 9, 6, 7, 0
    632  05b9
    633  05b9				   TwoDigits		; X = 0-99 -> temp = tens*5, temp+1 = ones*5
    634  05b9		       bd 20 f9 	      lda	Bin2BCD,x
    635  05bc		       4a		      lsr
    636  05bd		       4a		      lsr
    637  05be		       4a		      lsr
    638  05bf		       4a		      lsr
    639  05c0		       85 ad		      sta	temp
    640  05c2		       0a		      asl
    641  05c3		       0a		      asl
    642  05c4		       65 ad		      adc	temp
    643  05c6		       85 ad		      sta	temp
    644  05c8		       bd 20 f9 	      lda	Bin2BCD,x
    645  05cb		       29 0f		      and	#$0F
    646  05cd		       85 ae		      sta	temp+1
    647  05cf		       0a		      asl
    648  05d0		       0a		      asl
