    565  0528		       08 10 00    ScoreNext  .byte.b	$08, $10, $00	; ... and ask for the next
    566  052b				   .noScore
    567  052b		       ad e1 f0 	      lda	R_dirty
    568  052e		       29 02		      and	#2
    569  0530		       f0 27		      beq	.noBatt
    570  0532		       ae d1 f0 	      ldx	R_batt
