   1511  2acc		       a9 ff		      lda	#$FF
   1512  2ace		       95 9e		      sta	eTop,x
   1513  2ad0		       9d 05 f0 	      sta	W_eLane,x	; (no shelf: shots skip the empty slot)
   1514  2ad3		       60		      rts
