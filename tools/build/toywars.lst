     81 Uf07a ????				      SEG.U	scram
     82 Uf000					      ORG	$F000
     83 Uf000		       00 00 00 00*W_eX       ds	NENEMY	; enemies: left x
     84 Uf005		       00 00 00 00*W_eLane    ds	NENEMY	;   shelf 0-2
     85 Uf00a		       00 00 00 00*W_eType    ds	NENEMY	;   0 none, 1 dino, 2 helicopter, 3 crawler
     86 Uf00f		       00 00 00 00*W_eHP      ds	NENEMY	;   health
     87 Uf014		       00 00 00 00*W_eState   ds	NENEMY	;   bit 7 chewing, bit 6 hopped, bits 0-5 lasso frames left
     88 Uf019		       00 00 00 00*W_slotType ds	9	; toys per slot (shelf*3+column): 0 none, 1-6 (TOY_*)
     89 Uf022		       00 00 00 00*W_slotHP   ds	9
     90 Uf02b		       00 00 00 00*W_slotCool ds	9	; visits (6 frames) until the toy acts again
     91 Uf034		       00	   W_toyShelf ds	1	; the shelf whose toys act next
     92 Uf035		       00 00	   W_sndPos   ds	2	; per channel: position in SndData
     93 Uf037		       00 00	   W_sndTimer ds	2	;   ticks left in the step
     94 Uf039		       00 00	   W_sndPri   ds	2	;   priority of what's playing (0 = quiet)
     95 Uf03b		       00	   W_bossLeft ds	1	; T-Rexes still to come this wave
     96 Uf03c		       00	   W_packLeft ds	1	; wind-up mice still to come in the pack
     97 Uf03d		       00	   W_packTimer ds	1
     98 Uf03e		       00	   W_packLane ds	1
     99 Uf03f		       00	   W_game     ds	1	; game 1-3 (Game Select): starts at wave 1, 5 or 9
    100 Uf040		       00	   W_selPrev  ds	1	; Game Select held last frame
    101 Uf041		       00 00 00    W_shotDmg  ds	3	; per shelf: damage of the shot in flight, 0 = none
    102 Uf044		       00 00 00    W_shotKind ds	3	;   1 = an army man's bullet (passes over a chewing crawler)
    103 Uf047		       00 00 00    W_score    ds	3	; BCD, most significant first
    104 Uf04a		       00	   W_wave     ds	1	; binary, from 1
    105 Uf04b		       00	   W_batt     ds	1	; batteries, binary 0-99
    106 Uf04c		       00	   W_battTimer ds	1
    107 Uf04d		       00	   W_cursor   ds	1	; slot 0-8
    108 Uf04e		       00	   W_toy      ds	1	; toy type chosen for placing
    109 Uf04f		       00	   W_unlock   ds	1	; highest toy type unlocked
    110 Uf050		       00	   W_input    ds	1	; last frame's joystick (bits 3-0 right left down up) and fire (bit 7)
    111 Uf051		       00	   W_repeat   ds	1	; cursor auto-repeat countdown
