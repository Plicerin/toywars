   1528  2ae3							; Music (every other frame): an 8-bar toy march, eighth notes of 12 frames. Before a
   1529  2ae3							; game and at game over: melody on channel 0 and bass on channel 1; during
   1530  2ae3							; play: the melody alone, softly. A sound effect on a channel always wins;
   1531  2ae3							; the music picks up again at its next note.
   1532  2ae3				   Music
   1533  2ae3					      SUBROUTINE
   1534  2ae3		       ad c2 f0 	      lda	R_musTimer
   1535  2ae6		       18		      clc
   1536  2ae7		       69 02		      adc	#2
   1537  2ae9		       c9 0c		      cmp	#12
   1538  2aeb		       90 0d		      bcc	.same
   1539  2aed		       ad c1 f0 	      lda	R_musPos
   1540  2af0		       18		      clc
   1541  2af1		       69 01		      adc	#1
   1542  2af3		       29 3f		      and	#63
   1543  2af5		       8d 41 f0 	      sta	W_musPos
   1544  2af8		       a9 00		      lda	#0
   1545  2afa				   .same
   1546  2afa		       8d 42 f0 	      sta	W_musTimer
   1547  2afd							; melody, channel 0
   1548  2afd		       ad b9 f0 	      lda	R_sndPri
   1549  2b00		       d0 3d		      bne	.bass	; a sound effect has the channel
   1550  2b02		       ae c1 f0 	      ldx	R_musPos
   1551  2b05		       ad c2 f0 	      lda	R_musTimer
   1552  2b08		       d0 26		      bne	.melEnd
   1553  2b0a		       bc 7f fb 	      ldy	MelNote,x	; start of an eighth
   1554  2b0d		       c0 07		      cpy	#7
   1555  2b0f		       f0 2e		      beq	.bass	; a tie: keep sounding
   1556  2b11		       a9 00		      lda	#0
   1557  2b13		       c0 00		      cpy	#0
   1558  2b15		       f0 14		      beq	.melVol	; a rest
   1559  2b17		       a9 04		      lda	#4
   1560  2b19		       85 15		      sta	AUDC0
   1561  2b1b		       b9 c0 fb 	      lda	MelF,y
   1562  2b1e		       85 17		      sta	AUDF0
   1563  2b20		       a9 06		      lda	#6
   1564  2b22		       ac da f0 	      ldy	R_state
   1565  2b25		       c0 01		      cpy	#ST_PLAY
   1566  2b27		       d0 02		      bne	.melVol
   1567  2b29		       a9 03		      lda	#3	; softer under the game
   1568  2b2b				   .melVol
   1569  2b2b		       85 19		      sta	AUDV0
   1570  2b2d		       4c 3f fb 	      jmp	.bass
   1571  2b30				   .melEnd
   1572  2b30		       c9 0a		      cmp	#10	; the last two frames: a short gap before the next note
   1573  2b32		       d0 0b		      bne	.bass
   1574  2b34		       bd 80 fb 	      lda	MelNote+1,x	; (MelNote has a 65th byte: the first again)
   1575  2b37		       c9 07		      cmp	#7
   1576  2b39		       f0 04		      beq	.bass
   1577  2b3b		       a9 00		      lda	#0
   1578  2b3d		       85 19		      sta	AUDV0
   1579  2b3f				   .bass
   1580  2b3f							; bass, channel 1: only before a game and at game over
   1581  2b3f		       ad ba f0 	      lda	R_sndPri+1
   1582  2b42		       d0 0b		      bne	.done
   1583  2b44		       ad da f0 	      lda	R_state
   1584  2b47		       c9 01		      cmp	#ST_PLAY
   1585  2b49		       d0 05		      bne	.bassOn
   1586  2b4b		       a9 00		      lda	#0
   1587  2b4d		       85 1a		      sta	AUDV1
   1588  2b4f				   .done
   1589  2b4f		       60		      rts
   1590  2b50				   .bassOn
   1591  2b50		       ad c1 f0 	      lda	R_musPos
   1592  2b53		       4a		      lsr
   1593  2b54		       aa		      tax		; quarter note 0-31
   1594  2b55		       b0 1c		      bcs	.second	; the second eighth of the quarter
   1595  2b57		       ad c2 f0 	      lda	R_musTimer
   1596  2b5a		       d0 f3		      bne	.done
   1597  2b5c		       bc c7 fb 	      ldy	BassNote,x
   1598  2b5f		       a9 00		      lda	#0
   1599  2b61		       c0 00		      cpy	#0
   1600  2b63		       f0 0b		      beq	.bassVol
   1601  2b65		       a9 0c		      lda	#12
   1602  2b67		       85 16		      sta	AUDC1
   1603  2b69		       b9 e7 fb 	      lda	BassF,y
   1604  2b6c		       85 18		      sta	AUDF1
   1605  2b6e		       a9 05		      lda	#5
   1606  2b70				   .bassVol
   1607  2b70		       85 1a		      sta	AUDV1
   1608  2b72		       60		      rts
   1609  2b73				   .second
   1610  2b73		       ad c2 f0 	      lda	R_musTimer
   1611  2b76		       c9 06		      cmp	#6
   1612  2b78		       d0 d5		      bne	.done
   1613  2b7a		       a9 00		      lda	#0	; bass notes last an eighth and a half
   1614  2b7c		       85 1a		      sta	AUDV1
   1615  2b7e		       60		      rts
