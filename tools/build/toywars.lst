   1442  2a45							; Splash (odd frames): a cannonball's burst also hits every other monster on
   1443  2a45							; its shelf within SPLASH pixels of the one it hit; a jet's burst (bit 7 of
   1444  2a45							; splashN; no monster hit first) hits every monster on its shelf. One monster
   1445  2a45							; is checked a frame (five frames a burst), which keeps the frame time bounded
   1446  2a45				   Splash
   1447  2a45					      SUBROUTINE
   1448  2a45		       ad cb f0 	      lda	R_splashN
   1449  2a48		       f0 74		      beq	.done
   1450  2a4a		       85 b1		      sta	lt0
   1451  2a4c		       29 0f		      and	#$0F
   1452  2a4e		       aa		      tax
   1453  2a4f		       ca		      dex		; X = the monster to check
   1454  2a50		       d0 04		      bne	.more
   1455  2a52		       a9 00		      lda	#0	; the last one: the burst is over
   1456  2a54		       f0 05		      beq	.store
   1457  2a56				   .more
   1458  2a56		       a5 b1		      lda	lt0
   1459  2a58		       38		      sec
   1460  2a59		       e9 01		      sbc	#1
   1461  2a5b				   .store
   1462  2a5b		       8d 4b f0 	      sta	W_splashN
   1463  2a5e		       a5 b1		      lda	lt0
   1464  2a60		       4a		      lsr
   1465  2a61		       4a		      lsr
   1466  2a62		       4a		      lsr
   1467  2a63		       4a		      lsr
   1468  2a64		       85 b1		      sta	lt0	; the monster hit (8-15: a jet's burst)
   1469  2a66		       e4 b1		      cpx	lt0
   1470  2a68		       f0 54		      beq	.done	; (it took its hit already)
   1471  2a6a		       bd 8a f0 	      lda	R_eType,x
   1472  2a6d		       f0 4f		      beq	.done
   1473  2a6f		       bd 85 f0 	      lda	R_eLane,x
   1474  2a72		       cd ca f0 	      cmp	R_splashL
   1475  2a75		       d0 47		      bne	.done	; (a flying jet's shelf is 4-6)
   1476  2a77		       a5 b1		      lda	lt0
   1477  2a79		       29 08		      and	#8
   1478  2a7b		       d0 3c		      bne	.jet
   1479  2a7d		       bd 80 f0 	      lda	R_eX,x
   1480  2a80		       38		      sec
   1481  2a81		       ed c9 f0 	      sbc	R_splashX
   1482  2a84		       b0 04		      bcs	.right
   1483  2a86		       49 ff		      eor	#$FF	; (carry clear: + 1 makes it positive)
   1484  2a88		       69 01		      adc	#1
   1485  2a8a				   .right
   1486  2a8a		       a4 b1		      ldy	lt0
   1487  2a8c		       c0 07		      cpy	#7
   1488  2a8e		       f0 09		      beq	.jack
   1489  2a90		       c9 0d		      cmp	#SPLASH+1
   1490  2a92		       b0 2a		      bcs	.done
   1491  2a94		       a9 03		      lda	#CANNON_DMG
   1492  2a96		       4c ac f4 	      jmp	Damage
   1493  2a99				   .jack
   1494  2a99		       c9 09		      cmp	#JACK_REACH+1
   1495  2a9b		       b0 21		      bcs	.done
   1496  2a9d		       a9 0a		      lda	#JACK_DMG
   1497  2a9f		       20 ac f4 	      jsr	Damage
   1498  2aa2		       bd 8a f0 	      lda	R_eType,x
   1499  2aa5		       f0 17		      beq	.done	; (that was the end of it)
   1500  2aa7		       bd 80 f0 	      lda	R_eX,x	; the spring throws it back up the shelf
   1501  2aaa		       18		      clc
   1502  2aab		       69 18		      adc	#JACK_THROW
   1503  2aad		       c9 98		      cmp	#152
   1504  2aaf		       90 02		      bcc	.thrown
   1505  2ab1		       a9 97		      lda	#151
   1506  2ab3				   .thrown
