------- FILE toywars.asm
    971  0bfb
    972  0bfb							;-------------------------------------------------------------------------------
    973  0bfb							; F6 hotspots: an access to $FFF6/$FFF7/$FFF8/$FFF9 selects bank 0/1/2/3.
    974  0bfb							; A switch takes effect on the next fetch, at the same address in the new bank.
    975  0bfb							; Calls into bank 2: bank 0 switches, bank 2 (at the next address) does the
    976  0bfb							; JSR and switches back, and bank 0 returns.
    977  0fb0					      ORG	$0FB0
    978  0fb0					      RORG	$FFB0
    979  0fb0				   CallSound
    980  0fb0		       ad f9 ff 	      lda	$FFF9	; bank 3 runs $FFB3-$FFB8: jsr Sound, lda $FFF6
    981  0fb3		       ea ea ea ea*	      ds	6, $EA
    982  0fb9		       60		      rts		; $FFB9
    983  0fc0					      ORG	$0FC0
    984  0fc0					      RORG	$FFC0
    985  0fc0				   CallInit
    986  0fc0		       ad f8 ff 	      lda	$FFF8	; bank 2 runs $FFC3-$FFC8: jsr LogicInit, lda $FFF6
    987  0fc3		       ea ea ea ea*	      ds	6, $EA
    988  0fc9		       60		      rts		; $FFC9
    989  0fd0					      ORG	$0FD0
    990  0fd0					      RORG	$FFD0
    991  0fd0				   CallLogic
    992  0fd0		       ad f8 ff 	      lda	$FFF8	; bank 2 runs $FFD3-$FFD8: jsr Logic, lda $FFF6
    993  0fd3		       ea ea ea ea*	      ds	6, $EA
    994  0fd9		       60		      rts		; $FFD9
    995  0fda
    996  0fe0					      ORG	$0FE0
    997  0fe0					      RORG	$FFE0
    998  0fe0				   ToBank1
    999  0fe0		       ad f7 ff 	      lda	$FFF7	; bank 1 continues at $FFE3: jmp PreKernel
   1000  0fe3		       ea		      nop
   1001  0fe4		       ea		      nop
   1002  0fe5		       ea		      nop
   1003  0fe6		       ad f6 ff 	      lda	$FFF6	; ($FFE6) bank 1 switches here
   1004  0fe9		       4c 7d f4 	      jmp	Overscan	; ($FFE9)
   1005  0fec
   1006  0ff0					      ORG	$0FF0
   1007  0ff0					      RORG	$FFF0
   1008  0ff0				   Reset0
   1009  0ff0		       ad f6 ff 	      lda	$FFF6	; every bank's reset stub: the cartridge can
   1010  0ff3		       4c 00 f1 	      jmp	Start0	; power up in any bank
   1011  0ffa					      ORG	$0FFA
   1012  0ffa					      RORG	$FFFA
   1013  0ffa		       f0 ff f0 ff*	      .word.w	Reset0, Reset0, Reset0
   1014  1000
   1015  1000							;===============================================================================
   1016  1000							; BANK 1
   1017  1000							;===============================================================================
   1018  2000 ????				      SEG	bank1
   1019  1000					      ORG	$1000
   1020  1000					      RORG	$F000
   1021  1000		       00 00 00 00*	      ds	256, 0	; Super Chip RAM window
   1022  1100
