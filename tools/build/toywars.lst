------- FILE sound.asm LEVEL 2 PASS 2
      0  3100					      include	"sound.asm"
      1  3100							; Toy Wars, bank 3: sound steps and music, called from VBLANK (CallSound).
      2  3100							; They read and write RAM and their own tables only; SndPlay (bank 2) starts
      3  3100							; a sound through SndStart, offsets into SndData here.
      4  3100
      5  3100							;-------------------------------------------------------------------------------
      6  3100							; Sound (VBLANK, after the frame counter steps): after an even frame (the
      7  3100							; shots) the sound effects' next steps, which are two frames long; after an
      8  3100							; odd frame (the toys) the music. Here, not in the overscan, to keep the
      9  3100							; game logic's frames short.
     10  3100				   Sound
     11  3100					      SUBROUTINE
     12  3100		       a5 9c		      lda	frame
     13  3102		       4a		      lsr
     14  3103		       90 03		      bcc	.music
     15  3105		       4c 15 f2 	      jmp	SndUpdate
     16  3108				   .music
     17  3108		       4c 0b f1 	      jmp	Music
     18  310b
     19  310b							;-------------------------------------------------------------------------------
     20  310b							; Music (every other frame): an 8-bar toy march, eighth notes of 12 frames. Before a
     21  310b							; game and at game over: melody on channel 0 and bass on channel 1; during
     22  310b							; play: the melody alone, softly. A sound effect on a channel always wins;
     23  310b							; the music picks up again at its next note.
     24  310b				   Music
     25  310b					      SUBROUTINE
     26  310b		       ad c2 f0 	      lda	R_musTimer
     27  310e		       18		      clc
     28  310f		       69 02		      adc	#2
     29  3111		       c9 0c		      cmp	#12
     30  3113		       90 0d		      bcc	.same
     31  3115		       ad c1 f0 	      lda	R_musPos
     32  3118		       18		      clc
     33  3119		       69 01		      adc	#1
     34  311b		       29 3f		      and	#63
     35  311d		       8d 41 f0 	      sta	W_musPos
     36  3120		       a9 00		      lda	#0
     37  3122				   .same
     38  3122		       8d 42 f0 	      sta	W_musTimer
     39  3125							; melody, channel 0
     40  3125		       ad b9 f0 	      lda	R_sndPri
     41  3128		       d0 3d		      bne	.bass	; a sound effect has the channel
     42  312a		       ae c1 f0 	      ldx	R_musPos
     43  312d		       ad c2 f0 	      lda	R_musTimer
     44  3130		       d0 26		      bne	.melEnd
     45  3132		       bc a7 f1 	      ldy	MelNote,x	; start of an eighth
     46  3135		       c0 07		      cpy	#7
     47  3137		       f0 2e		      beq	.bass	; a tie: keep sounding
     48  3139		       a9 00		      lda	#0
     49  313b		       c0 00		      cpy	#0
     50  313d		       f0 14		      beq	.melVol	; a rest
     51  313f		       a9 04		      lda	#4
     52  3141		       85 15		      sta	AUDC0
     53  3143		       b9 e8 f1 	      lda	MelF,y
     54  3146		       85 17		      sta	AUDF0
     55  3148		       a9 06		      lda	#6
     56  314a		       ac db f0 	      ldy	R_state
     57  314d		       c0 01		      cpy	#ST_PLAY
     58  314f		       d0 02		      bne	.melVol
     59  3151		       a9 03		      lda	#3	; softer under the game
     60  3153				   .melVol
     61  3153		       85 19		      sta	AUDV0
     62  3155		       4c 67 f1 	      jmp	.bass
     63  3158				   .melEnd
     64  3158		       c9 0a		      cmp	#10	; the last two frames: a short gap before the next note
     65  315a		       d0 0b		      bne	.bass
     66  315c		       bd a8 f1 	      lda	MelNote+1,x	; (MelNote has a 65th byte: the first again)
     67  315f		       c9 07		      cmp	#7
     68  3161		       f0 04		      beq	.bass
     69  3163		       a9 00		      lda	#0
     70  3165		       85 19		      sta	AUDV0
     71  3167				   .bass
     72  3167							; bass, channel 1: only before a game and at game over
     73  3167		       ad ba f0 	      lda	R_sndPri+1
     74  316a		       d0 0b		      bne	.done
     75  316c		       ad db f0 	      lda	R_state
     76  316f		       c9 01		      cmp	#ST_PLAY
     77  3171		       d0 05		      bne	.bassOn
     78  3173		       a9 00		      lda	#0
     79  3175		       85 1a		      sta	AUDV1
     80  3177				   .done
     81  3177		       60		      rts
     82  3178				   .bassOn
     83  3178		       ad c1 f0 	      lda	R_musPos
     84  317b		       4a		      lsr
     85  317c		       aa		      tax		; quarter note 0-31
     86  317d		       b0 1c		      bcs	.second	; the second eighth of the quarter
     87  317f		       ad c2 f0 	      lda	R_musTimer
     88  3182		       d0 f3		      bne	.done
     89  3184		       bc ef f1 	      ldy	BassNote,x
     90  3187		       a9 00		      lda	#0
     91  3189		       c0 00		      cpy	#0
     92  318b		       f0 0b		      beq	.bassVol
     93  318d		       a9 0c		      lda	#12
     94  318f		       85 16		      sta	AUDC1
     95  3191		       b9 0f f2 	      lda	BassF,y
     96  3194		       85 18		      sta	AUDF1
     97  3196		       a9 05		      lda	#5
     98  3198				   .bassVol
     99  3198		       85 1a		      sta	AUDV1
    100  319a		       60		      rts
    101  319b				   .second
    102  319b		       ad c2 f0 	      lda	R_musTimer
    103  319e		       c9 06		      cmp	#6
    104  31a0		       d0 d5		      bne	.done
    105  31a2		       a9 00		      lda	#0	; bass notes last an eighth and a half
    106  31a4		       85 1a		      sta	AUDV1
    107  31a6		       60		      rts
    108  31a7
    109  31a7							; the theme (original): melody in eighths, 1-6 = C5 D5 E5 G5 A5 C6, 7 = tie,
    110  31a7							; 0 = rest; bass in quarters, 1-5 = F3 G3 A3 C4 E3
    111  31a7		       01 01 03 04*MelNote    .byte.b	1,1,3,4,3,1,4,7, 5,5,4,3,2,3,1,7
    112  31b7		       01 01 03 04*	      .byte.b	1,1,3,4,5,4,3,7, 2,3,2,1,2,7,7,0
    113  31c7		       03 03 04 05*	      .byte.b	3,3,4,5,6,5,4,7, 5,4,3,2,3,4,3,7
    114  31d7		       01 01 03 04*	      .byte.b	1,1,3,4,5,6,5,4, 3,2,3,2,1,7,7,0
    115  31e7		       01		      .byte.b	1
    116  31e8		       00 1d 1a 17*MelF       .byte.b	0, 29, 26, 23, 19, 17, 14	; AUDC 4: C5 D5 E5 G5 A5 C6
    117  31ef		       04 02 04 02*BassNote   .byte.b	4,2,4,2, 1,4,2,4, 4,2,3,5, 2,2,2,2
    118  31ff		       04 03 01 02*	      .byte.b	4,3,1,2, 1,4,2,4, 4,3,1,2, 2,2,4,0
    119  320f		       00 1d 1a 17*BassF      .byte.b	0, 29, 26, 23, 19, 31	; AUDC 12: F3 G3 A3 C4 E3
    120  3215
    121  3215							;-------------------------------------------------------------------------------
    122  3215				   SndUpdate		; every other frame: next step when a step's time is up
    123  3215					      SUBROUTINE
    124  3215		       a2 01		      ldx	#1
    125  3217				   .chan
    126  3217		       bd b7 f0 	      lda	R_sndTimer,x
    127  321a		       f0 09		      beq	.step
    128  321c		       38		      sec
    129  321d		       e9 01		      sbc	#1
    130  321f		       9d 37 f0 	      sta	W_sndTimer,x
