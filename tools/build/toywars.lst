   1369  29d7		       a5 b1		      lda	lt0
   1370  29d9		       4a		      lsr
   1371  29da		       4a		      lsr
   1372  29db		       4a		      lsr
   1373  29dc		       4a		      lsr
   1374  29dd		       85 b1		      sta	lt0	; the monster hit (8-15: a jet's burst)
   1375  29df		       e4 b1		      cpx	lt0
   1376  29e1		       f0 2e		      beq	.done	; (it took its hit already)
   1377  29e3		       bd 8a f0 	      lda	R_eType,x
   1378  29e6		       f0 29		      beq	.done
   1379  29e8		       bd 85 f0 	      lda	R_eLane,x
   1380  29eb		       cd ca f0 	      cmp	R_splashL
   1381  29ee		       d0 21		      bne	.done	; (a flying jet's shelf is 4-6)
   1382  29f0		       a5 b1		      lda	lt0
   1383  29f2		       29 08		      and	#8
   1384  29f4		       d0 16		      bne	.jet
   1385  29f6		       bd 80 f0 	      lda	R_eX,x
   1386  29f9		       38		      sec
   1387  29fa		       ed c9 f0 	      sbc	R_splashX
