    483  049f							; BuildStatus: rebuild the parts of the status line that changed (W_dirty).
    484  049f							; Cells (narrow 3x5 font, two characters per 8-pixel cell): 0-2 the score's
    485  049f							; last five digits (cell 2 holds one), 3 "W" + the wave's tens, 4 its ones;
    486  049f							; the sixth cell's bytes hold PF1: the batteries' two digits, in green.
    487  049f				   BuildStatus		; (one part per frame, to keep VBLANK short)
    488  049f					      SUBROUTINE
    489  049f		       ad e1 f0 	      lda	R_dirty	; game selection: the line reads GAME n
    490  04a2		       29 20		      and	#$20
    491  04a4		       f0 1e		      beq	.notGame
    492  04a6		       ae bf f0 	      ldx	R_game
    493  04a9		       bd 1c f9 	      lda	GameTextAt,x
    494  04ac		       aa		      tax
    495  04ad		       a0 00		      ldy	#0
    496  04af				   .game
    497  04af		       bd c2 f8 	      lda	GameText,x
    498  04b2		       99 62 f0 	      sta	W_cells,y
    499  04b5		       e8		      inx
    500  04b6		       c8		      iny
    501  04b7		       c0 1e		      cpy	#30
    502  04b9		       d0 f4		      bne	.game
    503  04bb		       ad e1 f0 	      lda	R_dirty
    504  04be		       29 df		      and	#$DF
    505  04c0		       8d 61 f0 	      sta	W_dirty
    506  04c3		       60		      rts
    507  04c4				   .notGame
    508  04c4							; the score's three cells one per frame: dirty bit 0, then 3, then 4
    509  04c4		       ad e1 f0 	      lda	R_dirty
    510  04c7		       29 19		      and	#$19
    511  04c9		       f0 67		      beq	.noScore
    512  04cb		       a2 00		      ldx	#0
    513  04cd		       4a		      lsr
    514  04ce		       b0 07		      bcs	.cell
    515  04d0		       e8		      inx
    516  04d1		       4a		      lsr
    517  04d2		       4a		      lsr
    518  04d3		       4a		      lsr
    519  04d4		       b0 01		      bcs	.cell
    520  04d6		       e8		      inx
    521  04d7				   .cell		; cell X: the low digit of score byte X, then
    522  04d7		       86 b0		      stx	temp+3	; the high digit of byte X+1 (cell 2: a blank)
    523  04d9		       bd cd f0 	      lda	R_score,x
    524  04dc		       29 0f		      and	#$0F
    525  04de		       85 ad		      sta	temp
    526  04e0		       0a		      asl
    527  04e1		       0a		      asl
    528  04e2		       65 ad		      adc	temp
    529  04e4		       85 ad		      sta	temp	; first digit * 5
    530  04e6		       a9 32		      lda	#50	; (DigitLo + 50 is blank)
    531  04e8		       e0 02		      cpx	#2
    532  04ea		       f0 0d		      beq	.last
    533  04ec		       bd ce f0 	      lda	R_score+1,x
    534  04ef		       4a		      lsr
    535  04f0		       4a		      lsr
    536  04f1		       4a		      lsr
    537  04f2		       4a		      lsr
    538  04f3		       85 ae		      sta	temp+1
    539  04f5		       0a		      asl
    540  04f6		       0a		      asl
    541  04f7		       65 ae		      adc	temp+1
    542  04f9				   .last
    543  04f9		       85 ae		      sta	temp+1	; second digit * 5
    544  04fb		       a5 b0		      lda	temp+3
    545  04fd		       0a		      asl
    546  04fe		       0a		      asl
    547  04ff		       65 b0		      adc	temp+3
    548  0501		       85 af		      sta	temp+2	; destination: cell * 5
    549  0503		       a0 04		      ldy	#4
    550  0505				   .row
    551  0505		       a6 ad		      ldx	temp
    552  0507		       bd 54 f8 	      lda	DigitHi,x
    553  050a		       a6 ae		      ldx	temp+1
    554  050c		       1d 86 f8 	      ora	DigitLo,x
    555  050f		       a6 af		      ldx	temp+2
    556  0511		       9d 62 f0 	      sta	W_cells,x
    557  0514		       e6 ad		      inc	temp
    558  0516		       e6 ae		      inc	temp+1
    559  0518		       e6 af		      inc	temp+2
    560  051a		       88		      dey
    561  051b		       10 e8		      bpl	.row
    562  051d		       a6 b0		      ldx	temp+3
