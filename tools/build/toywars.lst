     45 U00ea ????				      SEG.U	vars
     46 U0080					      ORG	$80
     47 U0080		       00 00	   pc0	      ds	2	; defender copy pointers (columns 0-2)
     48 U0082		       00 00	   pc1	      ds	2
     49 U0084		       00 00	   pc2	      ds	2
     50 U0086		       00 00	   m1ptr      ds	2	; shot (ENAM1) pointer
     51 U0088		       00 00	   p1ptr      ds	2	; enemy graphics pointer
     52 U008a		       00 00	   p1col      ds	2	; enemy color pointer (ColArr + feet row)
     53 U008c		       00 00	   stVec      ds	2	; next static row routine
     54 U008e		       00	   nextEv     ds	1	; y of the next event row
     55 U008f		       00	   nextSt     ds	1	; y of the next static row
     56 U0090		       00 00 00 00*slotPtr    ds	9	; defender pointer (low byte) per lane*3+column
     57 U0099		       00 00 00    shotPtr    ds	3	; shot pointer (low byte) per lane
     58 U009c		       00	   frame      ds	1
     59 U009d		       00	   pfColor    ds	1	; shelves and box (flashes white on a lid slam or air strike)
     60 U009e							; scheduler scratch: SelectEnemies (overscan) fills it, Schedule (VBLANK) reads it
     61 U009e		       00 00 00 00*eTop       ds	NENEMY	; event row
     62 U00a3		       00 00 00 00*eFeet      ds	NENEMY	; feet row
     63 U00a8		       00 00 00 00*eOrder     ds	NENEMY	; sorted order, bit 7 = drawn this frame
     64 U00ad		       00 00 00 00 temp       ds	4
     65 U00b1		       00	   lt0	      ds	1	; game logic scratch (bank 2)
     66 U00b2		       00	   lt1	      ds	1
     67 U00b3		       00	   lt2	      ds	1
     68 U00b4		       00	   lt3	      ds	1
     69 U00b5		       00	   lt4	      ds	1
     70 U00b6		       00	   lt5	      ds	1
     71 U00b7		       00	   sndX       ds	1	; SndPlay keeps X and Y here
     72 U00b8		       00	   sndY       ds	1
     73 U00b9		       00	   fast       ds	1	; bit 7: second-lap pace (wave 13+); bit 6: shorter spawn gaps (wave 13+ or left difficulty A); bit 5: difficulty A
     74 U00ba		       00 00 00 00*QUEUE      ds	48	; event records, 8 bytes: return lo, hi, gfx lo, hi, color lo, hi, HMP1, next y
     75 U00ba		       00 ff	   STACKTOP   =	$FF
     76 U00ea
     77 U00ea		       00 b0	   lineCnt    =	temp+3	; header loops
