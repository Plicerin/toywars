    667  0593		       8a		      txa
    668  0594		       f0 73		      beq	.selDone
    669  0596		       85 ae		      sta	temp+1	; candidates left
    670  0598		       a5 9c		      lda	frame
    671  059a		       29 07		      and	#7	; start: (frame & 7) mod n, so it visits every position
    672  059c		       38		      sec
    673  059d				   .mod
    674  059d		       e5 b0		      sbc	temp+3
    675  059f		       b0 fc		      bcs	.mod
    676  05a1		       65 b0		      adc	temp+3
    677  05a3		       85 af		      sta	temp+2
    678  05a5							;   The list is sorted by event row, so within each run (start..n-1, then
    679  05a5							;   0..start-1) a candidate can only overlap the last enemy taken in that
    680  05a5							;   run; in the second run it must also end above the first enemy taken in
    681  05a5							;   the first. QUEUE+0..3 (free until Schedule): last taken feet, any taken
    682  05a5							;   in this run, first run's first event row, in the second run.
    683  05a5		       a9 00		      lda	#0
    684  05a7		       85 bb		      sta	QUEUE+1
    685  05a9		       85 bd		      sta	QUEUE+3
    686  05ab		       a9 ff		      lda	#$FF
    687  05ad		       85 bc		      sta	QUEUE+2
