     82 U00ea							; Super Chip RAM (cartridge, 128 bytes): write at W_name, read at R_name
     83 U00ea							; ($80 higher). Game state that the kernel doesn't need lives here.
     84 Uf080 ????				      SEG.U	scram
     85 Uf000					      ORG	$F000
     86 Uf000		       00 00 00 00*W_eX       ds	NENEMY	; enemies: left x
     87 Uf005		       00 00 00 00*W_eLane    ds	NENEMY	;   shelf 0-2
     88 Uf00a		       00 00 00 00*W_eType    ds	NENEMY	;   0 none, 1 dino, 2 helicopter, 3 crawler
     89 Uf00f		       00 00 00 00*W_eHP      ds	NENEMY	;   health
     90 Uf014		       00 00 00 00*W_eState   ds	NENEMY	;   bit 7 chewing, bit 6 hopped (knight: shield broken; pogo: jumped),
     91 Uf019							;   bit 5 hurt (half its health or less), bit 4 a quarter or less,
     92 Uf019							;   bits 0-3 half its full health (at most 15)
     93 Uf019		       00 00 00 00*W_slotType ds	9	; toys per slot (shelf*3+column): 0 none, 1-6 (TOY_*)
     94 Uf022		       00 00 00 00*W_slotHP   ds	9
     95 Uf02b		       00 00 00 00*W_slotCool ds	9	; visits (6 frames) until the toy acts again
     96 Uf034		       00	   W_toyShelf ds	1	; the shelf whose toys act next
     97 Uf035		       00 00	   W_sndPos   ds	2	; per channel: position in SndData
     98 Uf037		       00 00	   W_sndTimer ds	2	;   ticks left in the step
     99 Uf039		       00 00	   W_sndPri   ds	2	;   priority of what's playing (0 = quiet)
    100 Uf03b		       00	   W_bossLeft ds	1	; T-Rexes still to come this wave
    101 Uf03c		       00	   W_packLeft ds	1	; wind-up mice still to come in the pack
    102 Uf03d		       00	   W_packTimer ds	1
    103 Uf03e		       00	   W_packLane ds	1
    104 Uf03f		       00	   W_game     ds	1	; game 1-3 (Game Select): starts at wave 1, 5 or 9
    105 Uf040		       00	   W_selPrev  ds	1	; Game Select held last frame
    106 Uf041		       00	   W_musPos   ds	1	; music: eighth note 0-63 of the theme
    107 Uf042		       00	   W_musTimer ds	1	;   frames into it (0-11)
    108 Uf043		       00 00 00    W_shotDmg  ds	3	; per shelf: damage of the shot in flight, 0 = none
    109 Uf046		       00 00 00    W_shotKind ds	3	;   1 = an army man's bullet (passes over a chewing crawler)
    110 Uf049		       00	   W_splashX  ds	1	; a cannonball's burst being swept (odd frames): x of the monster hit,
