    558  04f0		       60		      rts
    559  04f1				   .noBatt
    560  04f1		       ad e0 f0 	      lda	R_dirty
    561  04f4		       29 04		      and	#4
    562  04f6		       f0 2a		      beq	.done
    563  04f8		       ae cf f0 	      ldx	R_wave
    564  04fb		       e0 64		      cpx	#100
    565  04fd		       90 02		      bcc	.w
    566  04ff		       a2 63		      ldx	#99
    567  0501				   .w
    568  0501		       20 28 f5 	      jsr	TwoDigits
    569  0504		       a0 00		      ldy	#0
    570  0506				   .wave
    571  0506		       a6 ad		      ldx	temp
    572  0508		       bd 86 f8 	      lda	DigitLo,x
    573  050b		       19 bd f8 	      ora	WHi,y
    574  050e		       99 70 f0 	      sta	W_cells+15,y
    575  0511		       a6 ae		      ldx	temp+1
    576  0513		       bd 54 f8 	      lda	DigitHi,x
    577  0516		       99 75 f0 	      sta	W_cells+20,y
