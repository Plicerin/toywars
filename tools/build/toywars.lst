   1548  2af1		       38		      sec
   1549  2af2		       e9 01		      sbc	#1
   1550  2af4		       dd ad fe 	      cmp	LaneR0,x
   1551  2af7		       90 05		      bcc	.gone
   1552  2af9		       95 99		      sta	shotPtr,x
   1553  2afb		       4c 07 fb 	      jmp	.next
   1554  2afe				   .gone
   1555  2afe		       a9 50		      lda	#80
   1556  2b00		       95 99		      sta	shotPtr,x
