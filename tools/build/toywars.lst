    653  05d6							;-------------------------------------------------------------------------------
    654  05d6							; SelectEnemies (VBLANK): decide which enemies player 1 draws this frame. Each enemy needs rows E-1 .. feet, where E is its event row (the
    655  05d6							; first row at or above top-1 that the kernel allows) and E-1 is blank. They
    656  05d6							; are sorted by E; one that overlaps an enemy already taken waits.
    657  05d6				   SelectEnemies
    658  05d6					      SUBROUTINE
    659  05d6		       a2 04		      ldx	#NENEMY-1	; (eFeet/eTop come from EnemyRows in bank 2)
    660  05d8				   .clear
    661  05d8		       b5 a8		      lda	eOrder,x	; forget last frame's choice, keep the order
