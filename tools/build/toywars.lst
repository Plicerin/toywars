     48  2100		       00 00	   SND_CURSOR =	0
     49  2100		       00 01	   SND_SELECT =	1
     50  2100		       00 02	   SND_PLACE  =	2
     51  2100		       00 03	   SND_PICK   =	3
     52  2100		       00 04	   SND_NOBATT =	4
     53  2100		       00 05	   SND_WAVE   =	5
     54  2100		       00 06	   SND_OVER   =	6
     55  2100		       00 07	   SND_POP    =	7
     56  2100		       00 08	   SND_BOOM   =	8
     57  2100		       00 09	   SND_THUMP  =	9
     58  2100		       00 0a	   SND_SPRING =	10
