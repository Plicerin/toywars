------- FILE toywars.asm
    930  0bfb
    931  0bfb							;-------------------------------------------------------------------------------
    932  0bfb							; F6 hotspots: an access to $FFF6/$FFF7/$FFF8/$FFF9 selects bank 0/1/2/3.
    933  0bfb							; A switch takes effect on the next fetch, at the same address in the new bank.
    934  0bfb							; Calls into bank 2: bank 0 switches, bank 2 (at the next address) does the
    935  0bfb							; JSR and switches back, and bank 0 returns.
    936  0fb0					      ORG	$0FB0
    937  0fb0					      RORG	$FFB0
    938  0fb0				   CallSound
    939  0fb0		       ad f9 ff 	      lda	$FFF9	; bank 3 runs $FFB3-$FFB8: jsr Sound, lda $FFF6
    940  0fb3		       ea ea ea ea*	      ds	6, $EA
    941  0fb9		       60		      rts		; $FFB9
    942  0fc0					      ORG	$0FC0
    943  0fc0					      RORG	$FFC0
    944  0fc0				   CallInit
    945  0fc0		       ad f8 ff 	      lda	$FFF8	; bank 2 runs $FFC3-$FFC8: jsr LogicInit, lda $FFF6
    946  0fc3		       ea ea ea ea*	      ds	6, $EA
    947  0fc9		       60		      rts		; $FFC9
    948  0fd0					      ORG	$0FD0
    949  0fd0					      RORG	$FFD0
    950  0fd0				   CallLogic
    951  0fd0		       ad f8 ff 	      lda	$FFF8	; bank 2 runs $FFD3-$FFD8: jsr Logic, lda $FFF6
    952  0fd3		       ea ea ea ea*	      ds	6, $EA
    953  0fd9		       60		      rts		; $FFD9
    954  0fda
    955  0fe0					      ORG	$0FE0
    956  0fe0					      RORG	$FFE0
    957  0fe0				   ToBank1
    958  0fe0		       ad f7 ff 	      lda	$FFF7	; bank 1 continues at $FFE3: jmp PreKernel
    959  0fe3		       ea		      nop
    960  0fe4		       ea		      nop
    961  0fe5		       ea		      nop
    962  0fe6		       ad f6 ff 	      lda	$FFF6	; ($FFE6) bank 1 switches here
    963  0fe9		       4c 0e f4 	      jmp	Overscan	; ($FFE9)
    964  0fec
    965  0ff0					      ORG	$0FF0
    966  0ff0					      RORG	$FFF0
    967  0ff0				   Reset0
    968  0ff0		       ad f6 ff 	      lda	$FFF6	; every bank's reset stub: the cartridge can
    969  0ff3		       4c 00 f1 	      jmp	Start0	; power up in any bank
    970  0ffa					      ORG	$0FFA
    971  0ffa					      RORG	$FFFA
    972  0ffa		       f0 ff f0 ff*	      .word.w	Reset0, Reset0, Reset0
    973  1000
    974  1000							;===============================================================================
    975  1000							; BANK 1
    976  1000							;===============================================================================
    977  2000 ????				      SEG	bank1
    978  1000					      ORG	$1000
    979  1000					      RORG	$F000
    980  1000		       00 00 00 00*	      ds	256, 0	; Super Chip RAM window
    981  1100
