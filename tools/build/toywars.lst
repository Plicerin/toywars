    610  0545							;-------------------------------------------------------------------------------
    611  0545							; SelectEnemies (VBLANK): decide which enemies player 1 draws this frame. Each enemy needs rows E-1 .. feet, where E is its event row (the
    612  0545							; first row at or above top-1 that the kernel allows) and E-1 is blank. They
    613  0545							; are sorted by E; one that overlaps an enemy already taken waits.
    614  0545				   SelectEnemies
    615  0545					      SUBROUTINE
    616  0545		       a2 04		      ldx	#NENEMY-1	; (eFeet/eTop come from EnemyRows in bank 2)
    617  0547				   .clear
    618  0547		       b5 a8		      lda	eOrder,x	; forget last frame's choice, keep the order
    619  0549		       29 7f		      and	#$7F
    620  054b		       95 a8		      sta	eOrder,x
    621  054d		       ca		      dex
    622  054e		       10 f7		      bpl	.clear
    623  0550							; insertion sort of eOrder by eTop (nearly sorted already: cheap)
    624  0550		       a2 01		      ldx	#1
    625  0552				   .so
    626  0552		       86 b0		      stx	temp+3
    627  0554		       b5 a8		      lda	eOrder,x
    628  0556		       85 ad		      sta	temp
    629  0558		       a8		      tay
