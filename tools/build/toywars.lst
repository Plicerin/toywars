   1656  2ba1							;-------------------------------------------------------------------------------
   1657  2ba1							; JetAct (X = a launched jet): four pixels right per update; every enemy on
   1658  2ba1							; its shelf takes 10 damage once the nose has passed its middle. The jet's
   1659  2ba1							; health byte (unused for a jet) marks the enemy slots it has hit, so each is
   1660  2ba1							; hit exactly once; at most two an update (the rest the next one), so a pack
   1661  2ba1							; bunched together never dies all in one frame.
   1662  2ba1				   JetAct
   1663  2ba1					      SUBROUTINE
   1664  2ba1		       86 b4		      stx	lt3
   1665  2ba3		       bd 80 f0 	      lda	R_eX,x
   1666  2ba6		       18		      clc
   1667  2ba7		       69 0c		      adc	#12
   1668  2ba9		       85 b1		      sta	lt0	; the nose after this step
   1669  2bab		       bd 85 f0 	      lda	R_eLane,x
   1670  2bae		       29 03		      and	#3
   1671  2bb0		       85 b2		      sta	lt1
   1672  2bb2		       a9 02		      lda	#2
   1673  2bb4		       a4 b0		      ldy	KILLED
   1674  2bb6		       f0 02		      beq	.hits
   1675  2bb8		       a9 01		      lda	#1	; an enemy died this frame already: one hit
   1676  2bba				   .hits
   1677  2bba		       85 b6		      sta	lt5	; hits left this update
   1678  2bbc		       a0 04		      ldy	#NENEMY-1
   1679  2bbe				   .loop
   1680  2bbe		       b9 85 f0 	      lda	R_eLane,y	; (an empty slot's shelf is $FF, a jet's 4-6)
   1681  2bc1		       c5 b2		      cmp	lt1
   1682  2bc3		       d0 2e		      bne	.next
   1683  2bc5		       b9 80 f0 	      lda	R_eX,y
   1684  2bc8		       18		      clc
   1685  2bc9		       69 04		      adc	#4
   1686  2bcb		       c5 b1		      cmp	lt0
   1687  2bcd		       b0 24		      bcs	.next	; its middle is still ahead of the nose
   1688  2bcf		       a6 b4		      ldx	lt3
   1689  2bd1		       bd 8f f0 	      lda	R_eHP,x
   1690  2bd4		       39 ee fc 	      and	KindBit,y	; (bits 0-4: enemy slots 0-4)
   1691  2bd7		       d0 1a		      bne	.next	; hit already
   1692  2bd9		       a5 b6		      lda	lt5
   1693  2bdb		       f0 16		      beq	.next	; two this update: the next one gets it
   1694  2bdd		       c6 b6		      dec	lt5
   1695  2bdf		       bd 8f f0 	      lda	R_eHP,x
   1696  2be2		       19 ee fc 	      ora	KindBit,y
   1697  2be5		       9d 0f f0 	      sta	W_eHP,x
   1698  2be8		       84 b3		      sty	lt2
   1699  2bea		       a6 b3		      ldx	lt2
   1700  2bec		       a9 0a		      lda	#JET_DMG
   1701  2bee		       20 1a f5 	      jsr	Damage
   1702  2bf1		       a4 b3		      ldy	lt2
   1703  2bf3				   .next
   1704  2bf3		       88		      dey
   1705  2bf4		       10 c8		      bpl	.loop
   1706  2bf6		       a6 b4		      ldx	lt3
   1707  2bf8		       bd 80 f0 	      lda	R_eX,x
   1708  2bfb		       18		      clc
   1709  2bfc		       69 04		      adc	#4
   1710  2bfe		       c9 98		      cmp	#152
   1711  2c00		       b0 06		      bcs	.gone
   1712  2c02		       9d 00 f0 	      sta	W_eX,x
