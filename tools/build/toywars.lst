   1642  2b95							; Splash (odd frames): a cannonball's burst also hits every other monster on
   1643  2b95							; its shelf within SPLASH pixels of the one it hit; a jet's burst (bit 7 of
   1644  2b95							; splashN; no monster hit first) hits every monster on its shelf. One monster
   1645  2b95							; is checked a frame (five frames a burst), which keeps the frame time bounded
   1646  2b95				   Splash
   1647  2b95					      SUBROUTINE
   1648  2b95		       ad cb f0 	      lda	R_splashN
   1649  2b98		       f0 7c		      beq	.done
   1650  2b9a		       85 b1		      sta	lt0
   1651  2b9c		       29 0f		      and	#$0F
   1652  2b9e		       aa		      tax
   1653  2b9f		       ca		      dex		; X = the monster to check
   1654  2ba0		       d0 04		      bne	.more
   1655  2ba2		       a9 00		      lda	#0	; the last one: the burst is over
   1656  2ba4		       f0 05		      beq	.store
   1657  2ba6				   .more
   1658  2ba6		       a5 b1		      lda	lt0
   1659  2ba8		       38		      sec
   1660  2ba9		       e9 01		      sbc	#1
   1661  2bab				   .store
   1662  2bab		       8d 4b f0 	      sta	W_splashN
   1663  2bae		       a5 b1		      lda	lt0
   1664  2bb0		       4a		      lsr
   1665  2bb1		       4a		      lsr
   1666  2bb2		       4a		      lsr
   1667  2bb3		       4a		      lsr
   1668  2bb4		       85 b1		      sta	lt0	; the monster hit (8-15: a jet's burst)
   1669  2bb6		       e4 b1		      cpx	lt0
   1670  2bb8		       f0 5c		      beq	.done	; (it took its hit already)
   1671  2bba		       bd 8a f0 	      lda	R_eType,x
   1672  2bbd		       f0 57		      beq	.done
   1673  2bbf		       ad ca f0 	      lda	R_splashL
   1674  2bc2		       29 7f		      and	#$7F	; (bit 7: a power shot's burst)
   1675  2bc4		       dd 85 f0 	      cmp	R_eLane,x
   1676  2bc7		       d0 4d		      bne	.done	; (a flying jet's shelf is 4-6)
   1677  2bc9		       a5 b1		      lda	lt0
   1678  2bcb		       29 08		      and	#8
   1679  2bcd		       d0 42		      bne	.jet
   1680  2bcf		       bd 80 f0 	      lda	R_eX,x
   1681  2bd2		       38		      sec
   1682  2bd3		       ed c9 f0 	      sbc	R_splashX
   1683  2bd6		       b0 04		      bcs	.right
   1684  2bd8		       49 ff		      eor	#$FF	; (carry clear: + 1 makes it positive)
   1685  2bda		       69 01		      adc	#1
   1686  2bdc				   .right
   1687  2bdc		       a4 b1		      ldy	lt0
   1688  2bde		       c0 07		      cpy	#7
   1689  2be0		       f0 0f		      beq	.jack
   1690  2be2		       c9 0d		      cmp	#SPLASH+1
   1691  2be4		       b0 30		      bcs	.done
   1692  2be6		       a9 03		      lda	#CANNON_DMG
   1693  2be8		       2c ca f0 	      bit	R_splashL
   1694  2beb		       10 01		      bpl	.splashHit
   1695  2bed		       0a		      asl		; a power shot's burst: twice
   1696  2bee				   .splashHit
   1697  2bee		       4c df f5 	      jmp	Damage
   1698  2bf1				   .jack
   1699  2bf1		       c9 09		      cmp	#JACK_REACH+1
   1700  2bf3		       b0 21		      bcs	.done
   1701  2bf5		       a9 14		      lda	#JACK_DMG
   1702  2bf7		       20 df f5 	      jsr	Damage
   1703  2bfa		       bd 8a f0 	      lda	R_eType,x
   1704  2bfd		       f0 17		      beq	.done	; (that was the end of it)
   1705  2bff		       bd 80 f0 	      lda	R_eX,x	; the spring throws it back up the shelf
   1706  2c02		       18		      clc
   1707  2c03		       69 10		      adc	#JACK_THROW
   1708  2c05		       c9 98		      cmp	#152
   1709  2c07		       90 02		      bcc	.thrown
   1710  2c09		       a9 97		      lda	#151
   1711  2c0b				   .thrown
   1712  2c0b		       9d 00 f0 	      sta	W_eX,x
   1713  2c0e		       4c a2 f9 	      jmp	EnemyRow
   1714  2c11				   .jet
   1715  2c11		       a9 0a		      lda	#JET_DMG
   1716  2c13		       4c df f5 	      jmp	Damage
   1717  2c16				   .done
   1718  2c16		       60		      rts
