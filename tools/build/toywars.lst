   1451  2a7f							; Music (odd frames): an 8-bar toy march, eighth notes of 12 frames. Before a
   1452  2a7f							; game and at game over: melody on channel 0 and bass on channel 1; during
   1453  2a7f							; play: the melody alone, softly. A sound effect on a channel always wins;
   1454  2a7f							; the music picks up again at its next note.
   1455  2a7f				   Music
   1456  2a7f					      SUBROUTINE
   1457  2a7f		       ad c2 f0 	      lda	R_musTimer
   1458  2a82		       18		      clc
   1459  2a83		       69 02		      adc	#2
   1460  2a85		       c9 0c		      cmp	#12
   1461  2a87		       90 0d		      bcc	.same
   1462  2a89		       ad c1 f0 	      lda	R_musPos
   1463  2a8c		       18		      clc
   1464  2a8d		       69 01		      adc	#1
   1465  2a8f		       29 3f		      and	#63
   1466  2a91		       8d 41 f0 	      sta	W_musPos
   1467  2a94		       a9 00		      lda	#0
   1468  2a96				   .same
   1469  2a96		       8d 42 f0 	      sta	W_musTimer
   1470  2a99							; melody, channel 0
   1471  2a99		       ad b9 f0 	      lda	R_sndPri
   1472  2a9c		       d0 3d		      bne	.bass	; a sound effect has the channel
   1473  2a9e		       ae c1 f0 	      ldx	R_musPos
   1474  2aa1		       ad c2 f0 	      lda	R_musTimer
   1475  2aa4		       d0 26		      bne	.melEnd
   1476  2aa6		       bc 1b fb 	      ldy	MelNote,x	; start of an eighth
   1477  2aa9		       c0 07		      cpy	#7
   1478  2aab		       f0 2e		      beq	.bass	; a tie: keep sounding
   1479  2aad		       a9 00		      lda	#0
   1480  2aaf		       c0 00		      cpy	#0
   1481  2ab1		       f0 14		      beq	.melVol	; a rest
   1482  2ab3		       a9 04		      lda	#4
   1483  2ab5		       85 15		      sta	AUDC0
   1484  2ab7		       b9 5c fb 	      lda	MelF,y
   1485  2aba		       85 17		      sta	AUDF0
   1486  2abc		       a9 06		      lda	#6
   1487  2abe		       ac da f0 	      ldy	R_state
   1488  2ac1		       c0 01		      cpy	#ST_PLAY
   1489  2ac3		       d0 02		      bne	.melVol
   1490  2ac5		       a9 03		      lda	#3	; softer under the game
   1491  2ac7				   .melVol
   1492  2ac7		       85 19		      sta	AUDV0
   1493  2ac9		       4c db fa 	      jmp	.bass
   1494  2acc				   .melEnd
   1495  2acc		       c9 0a		      cmp	#10	; the last two frames: a short gap before the next note
   1496  2ace		       d0 0b		      bne	.bass
   1497  2ad0		       bd 1c fb 	      lda	MelNote+1,x	; (MelNote has a 65th byte: the first again)
   1498  2ad3		       c9 07		      cmp	#7
   1499  2ad5		       f0 04		      beq	.bass
   1500  2ad7		       a9 00		      lda	#0
   1501  2ad9		       85 19		      sta	AUDV0
   1502  2adb				   .bass
   1503  2adb							; bass, channel 1: only before a game and at game over
   1504  2adb		       ad ba f0 	      lda	R_sndPri+1
   1505  2ade		       d0 0b		      bne	.done
   1506  2ae0		       ad da f0 	      lda	R_state
   1507  2ae3		       c9 01		      cmp	#ST_PLAY
   1508  2ae5		       d0 05		      bne	.bassOn
   1509  2ae7		       a9 00		      lda	#0
   1510  2ae9		       85 1a		      sta	AUDV1
   1511  2aeb				   .done
   1512  2aeb		       60		      rts
   1513  2aec				   .bassOn
   1514  2aec		       ad c1 f0 	      lda	R_musPos
   1515  2aef		       4a		      lsr
   1516  2af0		       aa		      tax		; quarter note 0-31
   1517  2af1		       b0 1c		      bcs	.second	; the second eighth of the quarter
   1518  2af3		       ad c2 f0 	      lda	R_musTimer
   1519  2af6		       d0 f3		      bne	.done
   1520  2af8		       bc 63 fb 	      ldy	BassNote,x
   1521  2afb		       a9 00		      lda	#0
   1522  2afd		       c0 00		      cpy	#0
   1523  2aff		       f0 0b		      beq	.bassVol
   1524  2b01		       a9 0c		      lda	#12
   1525  2b03		       85 16		      sta	AUDC1
   1526  2b05		       b9 83 fb 	      lda	BassF,y
   1527  2b08		       85 18		      sta	AUDF1
   1528  2b0a		       a9 05		      lda	#5
   1529  2b0c				   .bassVol
   1530  2b0c		       85 1a		      sta	AUDV1
   1531  2b0e		       60		      rts
   1532  2b0f				   .second
   1533  2b0f		       ad c2 f0 	      lda	R_musTimer
   1534  2b12		       c9 06		      cmp	#6
   1535  2b14		       d0 d5		      bne	.done
   1536  2b16		       a9 00		      lda	#0	; bass notes last an eighth and a half
   1537  2b18		       85 1a		      sta	AUDV1
   1538  2b1a		       60		      rts
