   1503  2a9b							; ShotHit (X = shelf, lt0 = shot x): carry set if it hit an enemy
   1504  2a9b				   ShotHit
   1505  2a9b					      SUBROUTINE
   1506  2a9b		       a5 b1		      lda	lt0
   1507  2a9d		       18		      clc
   1508  2a9e		       69 03		      adc	#3
   1509  2aa0		       85 b4		      sta	lt3	; the shot's right end
   1510  2aa2		       a0 04		      ldy	#NENEMY-1
   1511  2aa4				   .loop
   1512  2aa4		       b9 85 f0 	      lda	R_eLane,y	; (an empty slot's shelf is $FF)
   1513  2aa7		       c5 b2		      cmp	lt1
   1514  2aa9		       d0 67		      bne	.next
   1515  2aab		       a5 b4		      lda	lt3
   1516  2aad		       d9 80 f0 	      cmp	R_eX,y
   1517  2ab0		       90 60		      bcc	.next	; shot ends left of the enemy
   1518  2ab2		       b9 80 f0 	      lda	R_eX,y
   1519  2ab5		       18		      clc
   1520  2ab6		       69 07		      adc	#7
   1521  2ab8		       c5 b1		      cmp	lt0
   1522  2aba		       90 56		      bcc	.next	; enemy ends left of the shot
   1523  2abc		       bd c6 f0 	      lda	R_shotKind,x
   1524  2abf		       c9 02		      cmp	#SHOT_TANK
   1525  2ac1		       d0 09		      bne	.notShell
   1526  2ac3		       b9 8a f0 	      lda	R_eType,y
   1527  2ac6		       c9 06		      cmp	#EN_BALLOON
   1528  2ac8		       f0 48		      beq	.next	; tank shells can't hit the balloon clown
   1529  2aca		       d0 10		      bne	.hit
   1530  2acc				   .notShell
   1531  2acc		       c9 01		      cmp	#SHOT_ARMY
   1532  2ace		       d0 0c		      bne	.hit
   1533  2ad0		       b9 8a f0 	      lda	R_eType,y
   1534  2ad3		       c9 03		      cmp	#EN_CRAWL
   1535  2ad5		       d0 05		      bne	.hit
   1536  2ad7		       b9 94 f0 	      lda	R_eState,y
