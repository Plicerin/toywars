   1605  2b58		       b9 80 f0 	      lda	R_eX,y
   1606  2b5b		       8d 49 f0 	      sta	W_splashX
   1607  2b5e		       bd c3 f0 	      lda	R_shotDmg,x	; (a power shot's burst: bit 7, the splash doubles too)
   1608  2b61		       c9 06		      cmp	#2*CANNON_DMG
   1609  2b63		       8a		      txa
   1610  2b64		       90 02		      bcc	.plainBurst
   1611  2b66		       09 80		      ora	#$80
   1612  2b68				   .plainBurst
   1613  2b68		       8d 4a f0 	      sta	W_splashL
   1614  2b6b		       98		      tya
   1615  2b6c		       0a		      asl
   1616  2b6d		       0a		      asl
   1617  2b6e		       0a		      asl
   1618  2b6f		       0a		      asl
