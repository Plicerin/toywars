    653  0581							; choose: walk the sorted list from position (frame & 7) mod n, wrapping,
    654  0581							; and take each enemy whose rows (event row - 1 .. feet) miss every enemy
    655  0581							; taken so far. The start moves every frame, so overlapping ones take turns.
    656  0581		       a2 00		      ldx	#0
    657  0583				   .count
    658  0583		       b4 a8		      ldy	eOrder,x
    659  0585		       b9 9e 00 	      lda	eTop,y
