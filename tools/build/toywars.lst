   1738  2c30							; SlotPointers: the kernel's defender pointers, one shelf per frame plus the
   1739  2c30							; cursor's slot. The cursor's slot shows the chosen toy as a blinking ghost
   1740  2c30							; when empty, or blinks its toy: off (fire boosts it), or to the shovel or
   1741  2c30							; the jet when one is chosen (fire digs it up, or launches a jet).
   1742  2c30				   SlotPointers
   1743  2c30					      SUBROUTINE
   1744  2c30		       ae d3 f0 	      ldx	R_cursor
   1745  2c33		       20 45 fc 	      jsr	SlotPointer
   1746  2c36		       ae b4 f0 	      ldx	R_toyShelf	; (the shelf the toys just took their turn on)
   1747  2c39		       bd 46 fe 	      lda	Lane3,x
   1748  2c3c		       aa		      tax
   1749  2c3d		       20 45 fc 	      jsr	SlotPointer
   1750  2c40		       e8		      inx
   1751  2c41		       20 45 fc 	      jsr	SlotPointer
   1752  2c44		       e8		      inx
   1753  2c45				   SlotPointer		; slot X
   1754  2c45					      SUBROUTINE
   1755  2c45		       bd 99 f0 	      lda	R_slotType,x
   1756  2c48		       85 b1		      sta	lt0
   1757  2c4a		       ec d3 f0 	      cpx	R_cursor
   1758  2c4d		       d0 2a		      bne	.show
   1759  2c4f		       ad db f0 	      lda	R_state
   1760  2c52		       c9 01		      cmp	#ST_PLAY
   1761  2c54		       d0 23		      bne	.show
   1762  2c56		       a5 b1		      lda	lt0
   1763  2c58		       d0 0e		      bne	.occupied
   1764  2c5a		       a5 9c		      lda	frame
   1765  2c5c		       29 10		      and	#16
   1766  2c5e		       f0 19		      beq	.show
   1767  2c60		       ad d4 f0 	      lda	R_toy
   1768  2c63		       85 b1		      sta	lt0
   1769  2c65		       4c 79 fc 	      jmp	.show
   1770  2c68				   .occupied
   1771  2c68		       a5 9c		      lda	frame
   1772  2c6a		       29 18		      and	#24
   1773  2c6c		       d0 0b		      bne	.show
   1774  2c6e		       ad d4 f0 	      lda	R_toy	; blinking: the shovel or the jet when chosen
   1775  2c71		       c9 06		      cmp	#TOY_JET	; (what fire would do: dig it up, launch a
   1776  2c73		       b0 02		      bcs	.what	; jet), else nothing (fire boosts it)
   1777  2c75		       a9 00		      lda	#0
   1778  2c77				   .what
