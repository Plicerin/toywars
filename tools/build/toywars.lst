------- FILE toywars.asm
    854  0a01
    855  0a01							;-------------------------------------------------------------------------------
    856  0a01							; F6 hotspots: an access to $FFF6/$FFF7/$FFF8/$FFF9 selects bank 0/1/2/3.
    857  0a01							; A switch takes effect on the next fetch, at the same address in the new bank.
    858  0a01							; Calls into bank 2: bank 0 switches, bank 2 (at the next address) does the
    859  0a01							; JSR and switches back, and bank 0 returns.
    860  0fc0					      ORG	$0FC0
    861  0fc0					      RORG	$FFC0
    862  0fc0				   CallInit
    863  0fc0		       ad f8 ff 	      lda	$FFF8	; bank 2 runs $FFC3-$FFC8: jsr LogicInit, lda $FFF6
    864  0fc3		       ea ea ea ea*	      ds	6, $EA
    865  0fc9		       60		      rts		; $FFC9
    866  0fd0					      ORG	$0FD0
    867  0fd0					      RORG	$FFD0
    868  0fd0				   CallLogic
    869  0fd0		       ad f8 ff 	      lda	$FFF8	; bank 2 runs $FFD3-$FFD8: jsr Logic, lda $FFF6
    870  0fd3		       ea ea ea ea*	      ds	6, $EA
    871  0fd9		       60		      rts		; $FFD9
    872  0fda
    873  0fe0					      ORG	$0FE0
    874  0fe0					      RORG	$FFE0
    875  0fe0				   ToBank1
    876  0fe0		       ad f7 ff 	      lda	$FFF7	; bank 1 continues at $FFE3: jmp PreKernel
    877  0fe3		       ea		      nop
    878  0fe4		       ea		      nop
    879  0fe5		       ea		      nop
    880  0fe6		       ad f6 ff 	      lda	$FFF6	; ($FFE6) bank 1 switches here
    881  0fe9		       4c 9b f2 	      jmp	Overscan	; ($FFE9)
    882  0fec
    883  0ff0					      ORG	$0FF0
    884  0ff0					      RORG	$FFF0
    885  0ff0				   Reset0
    886  0ff0		       ad f6 ff 	      lda	$FFF6	; every bank's reset stub: the cartridge can
    887  0ff3		       4c 00 f1 	      jmp	Start0	; power up in any bank
    888  0ffa					      ORG	$0FFA
    889  0ffa					      RORG	$FFFA
    890  0ffa		       f0 ff f0 ff*	      .word.w	Reset0, Reset0, Reset0
    891  1000
    892  1000							;===============================================================================
    893  1000							; BANK 1
    894  1000							;===============================================================================
    895  2000 ????				      SEG	bank1
    896  1000					      ORG	$1000
    897  1000					      RORG	$F000
    898  1000		       00 00 00 00*	      ds	256, 0	; Super Chip RAM window
    899  1100
