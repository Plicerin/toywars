     79 Uf074 ????				      SEG.U	scram
     80 Uf000					      ORG	$F000
     81 Uf000		       00 00 00 00*W_eX       ds	NENEMY	; enemies: left x
     82 Uf005		       00 00 00 00*W_eLane    ds	NENEMY	;   shelf 0-2
     83 Uf00a		       00 00 00 00*W_eType    ds	NENEMY	;   0 none, 1 dino, 2 helicopter, 3 crawler
     84 Uf00f		       00 00 00 00*W_eHP      ds	NENEMY	;   health
     85 Uf014		       00 00 00 00*W_eState   ds	NENEMY	;   bit 7 chewing, bit 6 hopped, bits 0-5 lasso frames left
     86 Uf019		       00 00 00 00*W_slotType ds	9	; toys per slot (shelf*3+column): 0 none, 1-6 (TOY_*)
     87 Uf022		       00 00 00 00*W_slotHP   ds	9
     88 Uf02b		       00 00 00 00*W_slotCool ds	9	; visits (6 frames) until the toy acts again
     89 Uf034		       00	   W_toyShelf ds	1	; the shelf whose toys act next
     90 Uf035		       00 00	   W_sndPos   ds	2	; per channel: position in SndData
     91 Uf037		       00 00	   W_sndTimer ds	2	;   ticks left in the step
     92 Uf039		       00 00	   W_sndPri   ds	2	;   priority of what's playing (0 = quiet)
     93 Uf03b		       00 00 00    W_shotDmg  ds	3	; per shelf: damage of the shot in flight, 0 = none
     94 Uf03e		       00 00 00    W_shotKind ds	3	;   1 = an army man's bullet (passes over a chewing crawler)
     95 Uf041		       00 00 00    W_score    ds	3	; BCD, most significant first
     96 Uf044		       00	   W_wave     ds	1	; binary, from 1
     97 Uf045		       00	   W_batt     ds	1	; batteries, binary 0-99
     98 Uf046		       00	   W_battTimer ds	1
     99 Uf047		       00	   W_cursor   ds	1	; slot 0-8
    100 Uf048		       00	   W_toy      ds	1	; toy type chosen for placing
    101 Uf049		       00	   W_unlock   ds	1	; highest toy type unlocked
    102 Uf04a		       00	   W_input    ds	1	; last frame's joystick (bits 3-0 right left down up) and fire (bit 7)
    103 Uf04b		       00	   W_repeat   ds	1	; cursor auto-repeat countdown
    104 Uf04c		       00	   W_fireState ds	1	; 1 = fire pressed (act on release), 2 = used to change toy
    105 Uf04d		       00	   W_swPrev   ds	1	; Game Reset held last frame
    106 Uf04e		       00	   W_lids     ds	1	; bits 0-2: shelf's lid slam used
    107 Uf04f		       00	   W_state    ds	1	; 0 attract, 1 playing, 2 game over
    108 Uf050		       00	   W_overTimer ds	1
    109 Uf051		       00	   W_spawnLeft ds	1
    110 Uf052		       00	   W_spawnTimer ds	1
    111 Uf053		       00	   W_rand     ds	1
    112 Uf054		       00	   W_flash    ds	1
