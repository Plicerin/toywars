   1552  2b89							;-------------------------------------------------------------------------------
   1553  2b89							; Sound: channel 0 plays the player's actions and jingles, channel 1 combat.
   1554  2b89							; A sound is a list of steps (ticks of two frames, AUDC*16+AUDV, AUDF) ending
   1555  2b89							; in a zero; a new sound replaces the one playing on its channel unless that
   1556  2b89							; one matters more (SndPri).
   1557  2b89				   SndPlay		; A = sound id; keeps X and Y
   1558  2b89					      SUBROUTINE
   1559  2b89		       86 b7		      stx	sndX
   1560  2b8b		       84 b8		      sty	sndY
   1561  2b8d		       a8		      tay
   1562  2b8e		       be 9c fc 	      ldx	SndChan,y
   1563  2b91		       b9 ac fc 	      lda	SndPri,y
   1564  2b94		       dd b9 f0 	      cmp	R_sndPri,x
   1565  2b97		       90 0e		      bcc	.done	; something more important is playing
   1566  2b99		       9d 39 f0 	      sta	W_sndPri,x
   1567  2b9c		       b9 8c fc 	      lda	SndStart,y
   1568  2b9f		       9d 35 f0 	      sta	W_sndPos,x
   1569  2ba2		       a9 00		      lda	#0
   1570  2ba4		       9d 37 f0 	      sta	W_sndTimer,x
   1571  2ba7				   .done
   1572  2ba7		       a6 b7		      ldx	sndX
   1573  2ba9		       a4 b8		      ldy	sndY
   1574  2bab		       60		      rts
   1575  2bac
   1576  2bac				   SndUpdate		; even frames: next step when a step's time is up
   1577  2bac					      SUBROUTINE
   1578  2bac		       a2 01		      ldx	#1
   1579  2bae				   .chan
   1580  2bae		       bd b7 f0 	      lda	R_sndTimer,x
   1581  2bb1		       f0 09		      beq	.step
   1582  2bb3		       38		      sec
   1583  2bb4		       e9 01		      sbc	#1
   1584  2bb6		       9d 37 f0 	      sta	W_sndTimer,x
   1585  2bb9		       4c f0 fb 	      jmp	.next
   1586  2bbc				   .step
   1587  2bbc		       bc b5 f0 	      ldy	R_sndPos,x
   1588  2bbf		       b9 f4 fb 	      lda	SndData,y
   1589  2bc2		       f0 25		      beq	.quiet
   1590  2bc4		       38		      sec
   1591  2bc5		       e9 01		      sbc	#1	; this tick is the step's first
   1592  2bc7		       9d 37 f0 	      sta	W_sndTimer,x
   1593  2bca		       b9 f5 fb 	      lda	SndData+1,y
   1594  2bcd		       4a		      lsr
