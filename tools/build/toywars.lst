   1681  2bc2		       85 b1		      sta	lt0
   1682  2bc4		       ec d3 f0 	      cpx	R_cursor
   1683  2bc7		       d0 23		      bne	.show
   1684  2bc9		       ad db f0 	      lda	R_state
   1685  2bcc		       c9 01		      cmp	#ST_PLAY
   1686  2bce		       d0 1c		      bne	.show
   1687  2bd0		       a5 b1		      lda	lt0
   1688  2bd2		       d0 0e		      bne	.occupied
   1689  2bd4		       a5 9c		      lda	frame
   1690  2bd6		       29 10		      and	#16
   1691  2bd8		       f0 12		      beq	.show
   1692  2bda		       ad d4 f0 	      lda	R_toy
   1693  2bdd		       85 b1		      sta	lt0
   1694  2bdf		       4c ec fb 	      jmp	.show
   1695  2be2				   .occupied
   1696  2be2		       a5 9c		      lda	frame
   1697  2be4		       29 18		      and	#24
   1698  2be6		       d0 04		      bne	.show
   1699  2be8		       a9 00		      lda	#0
   1700  2bea		       85 b1		      sta	lt0
   1701  2bec				   .show
   1702  2bec		       a4 b1		      ldy	lt0
   1703  2bee		       f0 0c		      beq	.empty
