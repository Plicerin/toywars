   1794  2c8f							;-------------------------------------------------------------------------------
   1795  2c8f							; JetAct (X = a launched jet): four pixels right per update; every enemy on
   1796  2c8f							; its shelf takes 10 damage once the nose has passed its middle. The jet's
   1797  2c8f							; health byte (unused for a jet) marks the enemy slots it has hit, so each is
   1798  2c8f							; hit exactly once; at most two an update (the rest the next one), so a pack
   1799  2c8f							; bunched together never dies all in one frame.
   1800  2c8f				   JetAct
   1801  2c8f					      SUBROUTINE
   1802  2c8f		       86 b4		      stx	lt3
   1803  2c91		       bd 80 f0 	      lda	R_eX,x
   1804  2c94		       18		      clc
   1805  2c95		       69 0c		      adc	#12
   1806  2c97		       85 b1		      sta	lt0	; the nose after this step
   1807  2c99		       bd 85 f0 	      lda	R_eLane,x
   1808  2c9c		       29 03		      and	#3
   1809  2c9e		       85 b2		      sta	lt1
   1810  2ca0		       a9 02		      lda	#2
   1811  2ca2		       a4 b0		      ldy	KILLED
   1812  2ca4		       f0 02		      beq	.hits
   1813  2ca6		       a9 01		      lda	#1	; an enemy died this frame already: one hit
   1814  2ca8				   .hits
   1815  2ca8		       85 b6		      sta	lt5	; hits left this update
   1816  2caa		       a0 04		      ldy	#NENEMY-1
   1817  2cac				   .loop
   1818  2cac		       b9 85 f0 	      lda	R_eLane,y	; (an empty slot's shelf is $FF, a jet's 4-6)
   1819  2caf		       c5 b2		      cmp	lt1
   1820  2cb1		       d0 2e		      bne	.next
   1821  2cb3		       b9 80 f0 	      lda	R_eX,y
   1822  2cb6		       18		      clc
   1823  2cb7		       69 04		      adc	#4
   1824  2cb9		       c5 b1		      cmp	lt0
   1825  2cbb		       b0 24		      bcs	.next	; its middle is still ahead of the nose
   1826  2cbd		       a6 b4		      ldx	lt3
   1827  2cbf		       bd 8f f0 	      lda	R_eHP,x
   1828  2cc2		       39 ed fd 	      and	KindBit,y	; (bits 0-4: enemy slots 0-4)
   1829  2cc5		       d0 1a		      bne	.next	; hit already
   1830  2cc7		       a5 b6		      lda	lt5
   1831  2cc9		       f0 16		      beq	.next	; two this update: the next one gets it
   1832  2ccb		       c6 b6		      dec	lt5
   1833  2ccd		       bd 8f f0 	      lda	R_eHP,x
   1834  2cd0		       19 ed fd 	      ora	KindBit,y
   1835  2cd3		       9d 0f f0 	      sta	W_eHP,x
   1836  2cd6		       84 b3		      sty	lt2
   1837  2cd8		       a6 b3		      ldx	lt2
   1838  2cda		       a9 0a		      lda	#JET_DMG
   1839  2cdc		       20 df f5 	      jsr	Damage
   1840  2cdf		       a4 b3		      ldy	lt2
   1841  2ce1				   .next
