   1599  2bd3		       b9 f5 fb 	      lda	SndData+1,y
   1600  2bd6		       29 0f		      and	#$0F
   1601  2bd8		       95 19		      sta	AUDV0,x
   1602  2bda		       b9 f6 fb 	      lda	SndData+2,y
   1603  2bdd		       95 17		      sta	AUDF0,x
   1604  2bdf		       98		      tya
   1605  2be0		       18		      clc
   1606  2be1		       69 03		      adc	#3
   1607  2be3		       9d 35 f0 	      sta	W_sndPos,x
   1608  2be6		       4c f0 fb 	      jmp	.next
   1609  2be9				   .quiet
