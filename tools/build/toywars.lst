   1571  2b12		       a0 04		      ldy	#NENEMY-1
   1572  2b14				   .loop
   1573  2b14		       b9 85 f0 	      lda	R_eLane,y	; (an empty slot's shelf is $FF)
   1574  2b17		       c5 b2		      cmp	lt1
   1575  2b19		       d0 75		      bne	.next
