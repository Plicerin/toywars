    495  04ae		       e8		      inx
    496  04af		       c8		      iny
    497  04b0		       c0 1e		      cpy	#30
    498  04b2		       d0 f4		      bne	.game
    499  04b4		       ad e1 f0 	      lda	R_dirty
    500  04b7		       29 df		      and	#$DF
    501  04b9		       8d 61 f0 	      sta	W_dirty
    502  04bc		       60		      rts
    503  04bd				   .notGame
    504  04bd							; the score's three cells one per frame: dirty bit 0, then 3, then 4
    505  04bd		       ad e1 f0 	      lda	R_dirty
    506  04c0		       29 19		      and	#$19
    507  04c2		       f0 67		      beq	.noScore
    508  04c4		       a2 00		      ldx	#0
    509  04c6		       4a		      lsr
    510  04c7		       b0 07		      bcs	.cell
    511  04c9		       e8		      inx
    512  04ca		       4a		      lsr
    513  04cb		       4a		      lsr
    514  04cc		       4a		      lsr
    515  04cd		       b0 01		      bcs	.cell
    516  04cf		       e8		      inx
    517  04d0				   .cell		; cell X: the low digit of score byte X, then
    518  04d0		       86 b0		      stx	temp+3	; the high digit of byte X+1 (cell 2: a blank)
    519  04d2		       bd cd f0 	      lda	R_score,x
    520  04d5		       29 0f		      and	#$0F
    521  04d7		       85 ad		      sta	temp
    522  04d9		       0a		      asl
    523  04da		       0a		      asl
    524  04db		       65 ad		      adc	temp
    525  04dd		       85 ad		      sta	temp	; first digit * 5
    526  04df		       a9 32		      lda	#50	; (DigitLo + 50 is blank)
    527  04e1		       e0 02		      cpx	#2
    528  04e3		       f0 0d		      beq	.last
    529  04e5		       bd ce f0 	      lda	R_score+1,x
    530  04e8		       4a		      lsr
    531  04e9		       4a		      lsr
    532  04ea		       4a		      lsr
    533  04eb		       4a		      lsr
    534  04ec		       85 ae		      sta	temp+1
    535  04ee		       0a		      asl
    536  04ef		       0a		      asl
    537  04f0		       65 ae		      adc	temp+1
    538  04f2				   .last
    539  04f2		       85 ae		      sta	temp+1	; second digit * 5
    540  04f4		       a5 b0		      lda	temp+3
    541  04f6		       0a		      asl
    542  04f7		       0a		      asl
    543  04f8		       65 b0		      adc	temp+3
    544  04fa		       85 af		      sta	temp+2	; destination: cell * 5
    545  04fc		       a0 04		      ldy	#4
    546  04fe				   .row
    547  04fe		       a6 ad		      ldx	temp
    548  0500		       bd 54 f8 	      lda	DigitHi,x
    549  0503		       a6 ae		      ldx	temp+1
    550  0505		       1d 86 f8 	      ora	DigitLo,x
    551  0508		       a6 af		      ldx	temp+2
    552  050a		       9d 62 f0 	      sta	W_cells,x
    553  050d		       e6 ad		      inc	temp
    554  050f		       e6 ae		      inc	temp+1
    555  0511		       e6 af		      inc	temp+2
    556  0513		       88		      dey
    557  0514		       10 e8		      bpl	.row
    558  0516		       a6 b0		      ldx	temp+3
