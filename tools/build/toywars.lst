    567  052b		       60		      rts
    568  052c		       fe f7 ef    ScoreDone  .byte.b	$FE, $F7, $EF	; clear this cell's bit ...
    569  052f		       08 10 00    ScoreNext  .byte.b	$08, $10, $00	; ... and ask for the next
    570  0532				   .noScore
    571  0532		       ad e1 f0 	      lda	R_dirty
    572  0535		       29 02		      and	#2
    573  0537		       f0 27		      beq	.noBatt
    574  0539		       ae d1 f0 	      ldx	R_batt
    575  053c		       20 b9 f5 	      jsr	TwoDigits	; temp = tens*5, temp+1 = ones*5
    576  053f		       a0 00		      ldy	#0
    577  0541				   .batt
    578  0541		       a6 ad		      ldx	temp
    579  0543		       bd 54 f8 	      lda	DigitHi,x
    580  0546		       a6 ae		      ldx	temp+1
    581  0548		       1d 86 f8 	      ora	DigitLo,x
    582  054b		       99 7b f0 	      sta	W_cells+25,y	; PF1
    583  054e		       e6 ad		      inc	temp
    584  0550		       e6 ae		      inc	temp+1
    585  0552		       c8		      iny
    586  0553		       c0 05		      cpy	#5
    587  0555		       d0 ea		      bne	.batt
    588  0557		       ad e1 f0 	      lda	R_dirty
    589  055a		       29 fd		      and	#$FD
    590  055c		       8d 61 f0 	      sta	W_dirty
    591  055f		       60		      rts
    592  0560				   .noBatt
    593  0560		       ad e1 f0 	      lda	R_dirty
    594  0563		       29 04		      and	#4
    595  0565		       f0 2a		      beq	.done
    596  0567		       ae d0 f0 	      ldx	R_wave
    597  056a		       e0 64		      cpx	#100
    598  056c		       90 02		      bcc	.w
    599  056e		       a2 63		      ldx	#99
    600  0570				   .w
    601  0570		       20 b9 f5 	      jsr	TwoDigits
    602  0573		       a0 00		      ldy	#0
    603  0575				   .wave
    604  0575		       a6 ad		      ldx	temp
    605  0577		       bd 86 f8 	      lda	DigitLo,x
    606  057a		       19 bd f8 	      ora	WHi,y
    607  057d		       99 71 f0 	      sta	W_cells+15,y
    608  0580		       a6 ae		      ldx	temp+1
    609  0582		       bd 54 f8 	      lda	DigitHi,x
    610  0585		       99 76 f0 	      sta	W_cells+20,y
    611  0588		       e6 ad		      inc	temp
    612  058a		       e6 ae		      inc	temp+1
    613  058c		       c8		      iny
    614  058d		       c0 05		      cpy	#5
    615  058f		       d0 e4		      bne	.wave
    616  0591				   .done
    617  0591		       a9 00		      lda	#0
    618  0593		       8d 61 f0 	      sta	W_dirty
    619  0596		       60		      rts
