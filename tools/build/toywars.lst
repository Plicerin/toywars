------- FILE toywars.asm
    798  09e1
    799  09e1							;-------------------------------------------------------------------------------
    800  09e1							; F6 hotspots: an access to $FFF6/$FFF7/$FFF8/$FFF9 selects bank 0/1/2/3.
    801  09e1							; A switch takes effect on the next fetch, at the same address in the new bank.
    802  09e1							; Calls into bank 2: bank 0 switches, bank 2 (at the next address) does the
    803  09e1							; JSR and switches back, and bank 0 returns.
    804  0fc0					      ORG	$0FC0
    805  0fc0					      RORG	$FFC0
    806  0fc0				   CallInit
    807  0fc0		       ad f8 ff 	      lda	$FFF8	; bank 2 runs $FFC3-$FFC8: jsr LogicInit, lda $FFF6
    808  0fc3		       ea ea ea ea*	      ds	6, $EA
    809  0fc9		       60		      rts		; $FFC9
    810  0fd0					      ORG	$0FD0
    811  0fd0					      RORG	$FFD0
    812  0fd0				   CallLogic
    813  0fd0		       ad f8 ff 	      lda	$FFF8	; bank 2 runs $FFD3-$FFD8: jsr Logic, lda $FFF6
    814  0fd3		       ea ea ea ea*	      ds	6, $EA
    815  0fd9		       60		      rts		; $FFD9
    816  0fda
    817  0fe0					      ORG	$0FE0
    818  0fe0					      RORG	$FFE0
    819  0fe0				   ToBank1
    820  0fe0		       ad f7 ff 	      lda	$FFF7	; bank 1 continues at $FFE3: jmp PreKernel
    821  0fe3		       ea		      nop
    822  0fe4		       ea		      nop
    823  0fe5		       ea		      nop
    824  0fe6		       ad f6 ff 	      lda	$FFF6	; ($FFE6) bank 1 switches here
    825  0fe9		       4c 9b f2 	      jmp	Overscan	; ($FFE9)
    826  0fec
    827  0ff0					      ORG	$0FF0
    828  0ff0					      RORG	$FFF0
    829  0ff0				   Reset0
    830  0ff0		       ad f6 ff 	      lda	$FFF6	; every bank's reset stub: the cartridge can
    831  0ff3		       4c 00 f1 	      jmp	Start0	; power up in any bank
    832  0ffa					      ORG	$0FFA
    833  0ffa					      RORG	$FFFA
    834  0ffa		       f0 ff f0 ff*	      .word.w	Reset0, Reset0, Reset0
    835  1000
    836  1000							;===============================================================================
    837  1000							; BANK 1
    838  1000							;===============================================================================
    839  2000 ????				      SEG	bank1
    840  1000					      ORG	$1000
    841  1000					      RORG	$F000
    842  1000		       00 00 00 00*	      ds	256, 0	; Super Chip RAM window
    843  1100
