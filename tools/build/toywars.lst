------- FILE logic.asm LEVEL 2 PASS 2
      0  2100					      include	"logic.asm"
      1  2100							; TOY WARS game logic (bank 2), included by toywars.asm.
      2  2100							;
      3  2100							; LogicInit runs once at power-on, Logic once per frame in overscan. Game
      4  2100							; state is in Super Chip RAM: read at R_name, written at W_name, so every
      5  2100							; change is load / modify / store (no INC/DEC on it). Toys and shots take
      6  2100							; turns: shots move on even frames, toys act on odd ones.
      7  2100
      8  2100		       00 01	   TOY_ARMY   =	1
      9  2100		       00 02	   TOY_TEDDY  =	2
     10  2100		       00 03	   TOY_TANK   =	3
     11  2100		       00 04	   TOY_COWBOY =	4
     12  2100		       00 05	   TOY_CANNON =	5
     13  2100		       00 06	   TOY_JET    =	6
     14  2100		       00 01	   EN_DINO    =	1
     15  2100		       00 02	   EN_HELI    =	2
     16  2100		       00 03	   EN_CRAWL   =	3
     17  2100		       00 00	   ST_ATTRACT =	0
     18  2100		       00 01	   ST_PLAY    =	1
     19  2100		       00 02	   ST_OVER    =	2
     20  2100		       00 0e	   COL_WHITE  =	$0E
     21  2100		       00 29	   BREACH_X   =	41	; an enemy left of this is at the toy box
     22  2100
     23  2100							; sound effects (ids into SndStart/SndChan/SndPri)
     24  2100		       00 00	   SND_CURSOR =	0
     25  2100		       00 01	   SND_SELECT =	1
     26  2100		       00 02	   SND_PLACE  =	2
     27  2100		       00 03	   SND_PICK   =	3
     28  2100		       00 04	   SND_NOBATT =	4
     29  2100		       00 05	   SND_WAVE   =	5
     30  2100		       00 06	   SND_OVER   =	6
     31  2100		       00 07	   SND_POP    =	7
     32  2100		       00 08	   SND_BOOM   =	8
     33  2100		       00 09	   SND_THUMP  =	9
     34  2100		       00 0a	   SND_LASSO  =	10
     35  2100		       00 0b	   SND_HIT    =	11
     36  2100		       00 0c	   SND_KILL   =	12
     37  2100		       00 0d	   SND_CHEW   =	13
     38  2100		       00 0e	   SND_SLAM   =	14
     39  2100		       00 0f	   SND_JET    =	15
     40  2100
     41  2100					      MAC	sound
     42  2100					      lda	#{1}
     43  2100					      jsr	SndPlay
     44  2100					      ENDM		; play sound {1} (keeps X and Y)
     45  2100
