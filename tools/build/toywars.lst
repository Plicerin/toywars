     28  2100		       00 02	   ST_OVER    =	2
     29  2100		       00 0e	   COL_WHITE  =	$0E
     30  2100		       00 29	   BREACH_X   =	41	; an enemy left of this is at the toy box
     31  2100
     32  2100							; sound effects (ids into SndStart/SndChan/SndPri)
     33  2100		       00 00	   SND_CURSOR =	0
