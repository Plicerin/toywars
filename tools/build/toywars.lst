------- FILE toywars.asm
    892  0a5f
    893  0a5f							;-------------------------------------------------------------------------------
    894  0a5f							; F6 hotspots: an access to $FFF6/$FFF7/$FFF8/$FFF9 selects bank 0/1/2/3.
    895  0a5f							; A switch takes effect on the next fetch, at the same address in the new bank.
    896  0a5f							; Calls into bank 2: bank 0 switches, bank 2 (at the next address) does the
    897  0a5f							; JSR and switches back, and bank 0 returns.
    898  0fc0					      ORG	$0FC0
    899  0fc0					      RORG	$FFC0
    900  0fc0				   CallInit
    901  0fc0		       ad f8 ff 	      lda	$FFF8	; bank 2 runs $FFC3-$FFC8: jsr LogicInit, lda $FFF6
    902  0fc3		       ea ea ea ea*	      ds	6, $EA
    903  0fc9		       60		      rts		; $FFC9
    904  0fd0					      ORG	$0FD0
    905  0fd0					      RORG	$FFD0
    906  0fd0				   CallLogic
    907  0fd0		       ad f8 ff 	      lda	$FFF8	; bank 2 runs $FFD3-$FFD8: jsr Logic, lda $FFF6
    908  0fd3		       ea ea ea ea*	      ds	6, $EA
    909  0fd9		       60		      rts		; $FFD9
    910  0fda
    911  0fe0					      ORG	$0FE0
    912  0fe0					      RORG	$FFE0
    913  0fe0				   ToBank1
    914  0fe0		       ad f7 ff 	      lda	$FFF7	; bank 1 continues at $FFE3: jmp PreKernel
    915  0fe3		       ea		      nop
    916  0fe4		       ea		      nop
    917  0fe5		       ea		      nop
    918  0fe6		       ad f6 ff 	      lda	$FFF6	; ($FFE6) bank 1 switches here
    919  0fe9		       4c 9b f2 	      jmp	Overscan	; ($FFE9)
    920  0fec
    921  0ff0					      ORG	$0FF0
    922  0ff0					      RORG	$FFF0
    923  0ff0				   Reset0
    924  0ff0		       ad f6 ff 	      lda	$FFF6	; every bank's reset stub: the cartridge can
    925  0ff3		       4c 00 f1 	      jmp	Start0	; power up in any bank
    926  0ffa					      ORG	$0FFA
    927  0ffa					      RORG	$FFFA
    928  0ffa		       f0 ff f0 ff*	      .word.w	Reset0, Reset0, Reset0
    929  1000
    930  1000							;===============================================================================
    931  1000							; BANK 1
    932  1000							;===============================================================================
    933  2000 ????				      SEG	bank1
    934  1000					      ORG	$1000
    935  1000					      RORG	$F000
    936  1000		       00 00 00 00*	      ds	256, 0	; Super Chip RAM window
    937  1100
