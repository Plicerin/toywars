------- FILE toywars.asm
    912  0bfb
    913  0bfb							;-------------------------------------------------------------------------------
    914  0bfb							; F6 hotspots: an access to $FFF6/$FFF7/$FFF8/$FFF9 selects bank 0/1/2/3.
    915  0bfb							; A switch takes effect on the next fetch, at the same address in the new bank.
    916  0bfb							; Calls into bank 2: bank 0 switches, bank 2 (at the next address) does the
    917  0bfb							; JSR and switches back, and bank 0 returns.
    918  0fb0					      ORG	$0FB0
    919  0fb0					      RORG	$FFB0
    920  0fb0				   CallSound
    921  0fb0		       ad f8 ff 	      lda	$FFF8	; bank 2 runs $FFB3-$FFB8: jsr Sound, lda $FFF6
    922  0fb3		       ea ea ea ea*	      ds	6, $EA
    923  0fb9		       60		      rts		; $FFB9
    924  0fc0					      ORG	$0FC0
    925  0fc0					      RORG	$FFC0
    926  0fc0				   CallInit
    927  0fc0		       ad f8 ff 	      lda	$FFF8	; bank 2 runs $FFC3-$FFC8: jsr LogicInit, lda $FFF6
    928  0fc3		       ea ea ea ea*	      ds	6, $EA
    929  0fc9		       60		      rts		; $FFC9
    930  0fd0					      ORG	$0FD0
    931  0fd0					      RORG	$FFD0
    932  0fd0				   CallLogic
    933  0fd0		       ad f8 ff 	      lda	$FFF8	; bank 2 runs $FFD3-$FFD8: jsr Logic, lda $FFF6
    934  0fd3		       ea ea ea ea*	      ds	6, $EA
    935  0fd9		       60		      rts		; $FFD9
    936  0fda
    937  0fe0					      ORG	$0FE0
    938  0fe0					      RORG	$FFE0
    939  0fe0				   ToBank1
    940  0fe0		       ad f7 ff 	      lda	$FFF7	; bank 1 continues at $FFE3: jmp PreKernel
    941  0fe3		       ea		      nop
    942  0fe4		       ea		      nop
    943  0fe5		       ea		      nop
    944  0fe6		       ad f6 ff 	      lda	$FFF6	; ($FFE6) bank 1 switches here
    945  0fe9		       4c 0e f4 	      jmp	Overscan	; ($FFE9)
    946  0fec
    947  0ff0					      ORG	$0FF0
    948  0ff0					      RORG	$FFF0
    949  0ff0				   Reset0
    950  0ff0		       ad f6 ff 	      lda	$FFF6	; every bank's reset stub: the cartridge can
    951  0ff3		       4c 00 f1 	      jmp	Start0	; power up in any bank
    952  0ffa					      ORG	$0FFA
    953  0ffa					      RORG	$FFFA
    954  0ffa		       f0 ff f0 ff*	      .word.w	Reset0, Reset0, Reset0
    955  1000
    956  1000							;===============================================================================
    957  1000							; BANK 1
    958  1000							;===============================================================================
    959  2000 ????				      SEG	bank1
    960  1000					      ORG	$1000
    961  1000					      RORG	$F000
    962  1000		       00 00 00 00*	      ds	256, 0	; Super Chip RAM window
    963  1100
