     84 Uf07f ????				      SEG.U	scram
     85 Uf000					      ORG	$F000
     86 Uf000		       00 00 00 00*W_eX       ds	NENEMY	; enemies: left x
     87 Uf005		       00 00 00 00*W_eLane    ds	NENEMY	;   shelf 0-2
     88 Uf00a		       00 00 00 00*W_eType    ds	NENEMY	;   0 none, 1 dino, 2 helicopter, 3 crawler
     89 Uf00f		       00 00 00 00*W_eHP      ds	NENEMY	;   health
     90 Uf014		       00 00 00 00*W_eState   ds	NENEMY	;   bit 7 chewing, bit 6 hopped, bits 0-5 lasso frames left
     91 Uf019		       00 00 00 00*W_slotType ds	9	; toys per slot (shelf*3+column): 0 none, 1-6 (TOY_*)
     92 Uf022		       00 00 00 00*W_slotHP   ds	9
     93 Uf02b		       00 00 00 00*W_slotCool ds	9	; visits (6 frames) until the toy acts again
     94 Uf034		       00	   W_toyShelf ds	1	; the shelf whose toys act next
     95 Uf035		       00 00	   W_sndPos   ds	2	; per channel: position in SndData
     96 Uf037		       00 00	   W_sndTimer ds	2	;   ticks left in the step
     97 Uf039		       00 00	   W_sndPri   ds	2	;   priority of what's playing (0 = quiet)
     98 Uf03b		       00	   W_bossLeft ds	1	; T-Rexes still to come this wave
     99 Uf03c		       00	   W_packLeft ds	1	; wind-up mice still to come in the pack
    100 Uf03d		       00	   W_packTimer ds	1
    101 Uf03e		       00	   W_packLane ds	1
    102 Uf03f		       00	   W_game     ds	1	; game 1-3 (Game Select): starts at wave 1, 5 or 9
    103 Uf040		       00	   W_selPrev  ds	1	; Game Select held last frame
    104 Uf041		       00	   W_musPos   ds	1	; music: eighth note 0-63 of the theme
    105 Uf042		       00	   W_musTimer ds	1	;   frames into it (0-11)
    106 Uf043		       00 00 00    W_shotDmg  ds	3	; per shelf: damage of the shot in flight, 0 = none
    107 Uf046		       00 00 00    W_shotKind ds	3	;   1 = an army man's bullet (passes over a chewing crawler)
    108 Uf049		       00	   W_splashX  ds	1	; a cannonball's burst being swept (odd frames): x of the monster hit,
    109 Uf04a		       00	   W_splashL  ds	1	;   its shelf,
    110 Uf04b		       00	   W_splashN  ds	1	;   that monster << 4 | monsters left to check (0 = none)
    111 Uf04c		       00 00 00    W_score    ds	3	; BCD, most significant first
