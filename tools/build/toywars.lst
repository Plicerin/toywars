    479  0498							; BuildStatus: rebuild the parts of the status line that changed (W_dirty).
    480  0498							; Cells (narrow 3x5 font, two characters per 8-pixel cell): 0-2 the score's
    481  0498							; last five digits (cell 2 holds one), 3 "W" + the wave's tens, 4 its ones;
    482  0498							; the sixth cell's bytes hold PF1: the batteries' two digits, in green.
    483  0498				   BuildStatus		; (one part per frame, to keep VBLANK short)
    484  0498					      SUBROUTINE
    485  0498		       ad e1 f0 	      lda	R_dirty	; game selection: the line reads GAME n
    486  049b		       29 20		      and	#$20
    487  049d		       f0 1e		      beq	.notGame
    488  049f		       ae bf f0 	      ldx	R_game
    489  04a2		       bd 1c f9 	      lda	GameTextAt,x
    490  04a5		       aa		      tax
    491  04a6		       a0 00		      ldy	#0
