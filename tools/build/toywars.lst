   1573  2b17							; Splash (odd frames): a cannonball's burst also hits every other monster on
   1574  2b17							; its shelf within SPLASH pixels of the one it hit; a jet's burst (bit 7 of
   1575  2b17							; splashN; no monster hit first) hits every monster on its shelf. One monster
   1576  2b17							; is checked a frame (five frames a burst), which keeps the frame time bounded
   1577  2b17				   Splash
   1578  2b17					      SUBROUTINE
   1579  2b17		       ad cb f0 	      lda	R_splashN
   1580  2b1a		       f0 74		      beq	.done
   1581  2b1c		       85 b1		      sta	lt0
   1582  2b1e		       29 0f		      and	#$0F
   1583  2b20		       aa		      tax
   1584  2b21		       ca		      dex		; X = the monster to check
   1585  2b22		       d0 04		      bne	.more
   1586  2b24		       a9 00		      lda	#0	; the last one: the burst is over
   1587  2b26		       f0 05		      beq	.store
   1588  2b28				   .more
   1589  2b28		       a5 b1		      lda	lt0
   1590  2b2a		       38		      sec
   1591  2b2b		       e9 01		      sbc	#1
   1592  2b2d				   .store
   1593  2b2d		       8d 4b f0 	      sta	W_splashN
   1594  2b30		       a5 b1		      lda	lt0
   1595  2b32		       4a		      lsr
   1596  2b33		       4a		      lsr
   1597  2b34		       4a		      lsr
   1598  2b35		       4a		      lsr
   1599  2b36		       85 b1		      sta	lt0	; the monster hit (8-15: a jet's burst)
   1600  2b38		       e4 b1		      cpx	lt0
   1601  2b3a		       f0 54		      beq	.done	; (it took its hit already)
   1602  2b3c		       bd 8a f0 	      lda	R_eType,x
   1603  2b3f		       f0 4f		      beq	.done
   1604  2b41		       bd 85 f0 	      lda	R_eLane,x
   1605  2b44		       cd ca f0 	      cmp	R_splashL
   1606  2b47		       d0 47		      bne	.done	; (a flying jet's shelf is 4-6)
   1607  2b49		       a5 b1		      lda	lt0
   1608  2b4b		       29 08		      and	#8
   1609  2b4d		       d0 3c		      bne	.jet
   1610  2b4f		       bd 80 f0 	      lda	R_eX,x
   1611  2b52		       38		      sec
   1612  2b53		       ed c9 f0 	      sbc	R_splashX
   1613  2b56		       b0 04		      bcs	.right
   1614  2b58		       49 ff		      eor	#$FF	; (carry clear: + 1 makes it positive)
   1615  2b5a		       69 01		      adc	#1
   1616  2b5c				   .right
   1617  2b5c		       a4 b1		      ldy	lt0
   1618  2b5e		       c0 07		      cpy	#7
   1619  2b60		       f0 09		      beq	.jack
   1620  2b62		       c9 0d		      cmp	#SPLASH+1
   1621  2b64		       b0 2a		      bcs	.done
   1622  2b66		       a9 03		      lda	#CANNON_DMG
   1623  2b68		       4c 6f f5 	      jmp	Damage
   1624  2b6b				   .jack
   1625  2b6b		       c9 09		      cmp	#JACK_REACH+1
   1626  2b6d		       b0 21		      bcs	.done
   1627  2b6f		       a9 14		      lda	#JACK_DMG
   1628  2b71		       20 6f f5 	      jsr	Damage
   1629  2b74		       bd 8a f0 	      lda	R_eType,x
   1630  2b77		       f0 17		      beq	.done	; (that was the end of it)
   1631  2b79		       bd 80 f0 	      lda	R_eX,x	; the spring throws it back up the shelf
   1632  2b7c		       18		      clc
   1633  2b7d		       69 10		      adc	#JACK_THROW
   1634  2b7f		       c9 98		      cmp	#152
   1635  2b81		       90 02		      bcc	.thrown
   1636  2b83		       a9 97		      lda	#151
   1637  2b85				   .thrown
   1638  2b85		       9d 00 f0 	      sta	W_eX,x
   1639  2b88		       4c 32 f9 	      jmp	EnemyRow
   1640  2b8b				   .jet
   1641  2b8b		       a9 0a		      lda	#JET_DMG
   1642  2b8d		       4c 6f f5 	      jmp	Damage
   1643  2b90				   .done
   1644  2b90		       60		      rts
