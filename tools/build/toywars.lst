    480  0377		       4c 7e f3 	      jmp	.next
    481  037a				   .none
    482  037a		       a9 ff		      lda	#$FF
    483  037c		       95 9d		      sta	eTop,x
    484  037e				   .next
    485  037e		       ca		      dex
    486  037f		       10 d0		      bpl	.tf
    487  0381							; insertion sort of eOrder by eTop
    488  0381		       a2 01		      ldx	#1
    489  0383				   .so
