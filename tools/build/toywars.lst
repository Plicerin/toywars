    572  0538		       a0 00		      ldy	#0
    573  053a				   .batt
    574  053a		       a6 ad		      ldx	temp
    575  053c		       bd 54 f8 	      lda	DigitHi,x
    576  053f		       a6 ae		      ldx	temp+1
    577  0541		       1d 86 f8 	      ora	DigitLo,x
    578  0544		       99 7b f0 	      sta	W_cells+25,y	; PF1
    579  0547		       e6 ad		      inc	temp
    580  0549		       e6 ae		      inc	temp+1
    581  054b		       c8		      iny
    582  054c		       c0 05		      cpy	#5
    583  054e		       d0 ea		      bne	.batt
    584  0550		       ad e1 f0 	      lda	R_dirty
    585  0553		       29 fd		      and	#$FD
    586  0555		       8d 61 f0 	      sta	W_dirty
    587  0558		       60		      rts
    588  0559				   .noBatt
    589  0559		       ad e1 f0 	      lda	R_dirty
    590  055c		       29 04		      and	#4
    591  055e		       f0 2a		      beq	.done
    592  0560		       ae d0 f0 	      ldx	R_wave
    593  0563		       e0 64		      cpx	#100
    594  0565		       90 02		      bcc	.w
    595  0567		       a2 63		      ldx	#99
    596  0569				   .w
    597  0569		       20 a4 f5 	      jsr	TwoDigits
    598  056c		       a0 00		      ldy	#0
    599  056e				   .wave
    600  056e		       a6 ad		      ldx	temp
    601  0570		       bd 86 f8 	      lda	DigitLo,x
    602  0573		       19 bd f8 	      ora	WHi,y
    603  0576		       99 71 f0 	      sta	W_cells+15,y
    604  0579		       a6 ae		      ldx	temp+1
    605  057b		       bd 54 f8 	      lda	DigitHi,x
    606  057e		       99 76 f0 	      sta	W_cells+20,y
    607  0581		       e6 ad		      inc	temp
    608  0583		       e6 ae		      inc	temp+1
    609  0585		       c8		      iny
    610  0586		       c0 05		      cpy	#5
    611  0588		       d0 e4		      bne	.wave
    612  058a				   .done
    613  058a		       a9 00		      lda	#0
    614  058c		       8d 61 f0 	      sta	W_dirty
    615  058f		       60		      rts
