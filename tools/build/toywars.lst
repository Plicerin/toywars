   1544  2b3b		       03 03 04 05*	      .byte.b	3,3,4,5,6,5,4,7, 5,4,3,2,3,4,3,7
   1545  2b4b		       01 01 03 04*	      .byte.b	1,1,3,4,5,6,5,4, 3,2,3,2,1,7,7,0
   1546  2b5b		       01		      .byte.b	1
   1547  2b5c		       00 1d 1a 17*MelF       .byte.b	0, 29, 26, 23, 19, 17, 14	; AUDC 4: C5 D5 E5 G5 A5 C6
   1548  2b63		       04 02 04 02*BassNote   .byte.b	4,2,4,2, 1,4,2,4, 4,2,3,5, 2,2,2,2
   1549  2b73		       04 03 01 02*	      .byte.b	4,3,1,2, 1,4,2,4, 4,3,1,2, 2,2,4,0
   1550  2b83		       00 1d 1a 17*BassF      .byte.b	0, 29, 26, 23, 19, 31	; AUDC 12: F3 G3 A3 C4 E3
