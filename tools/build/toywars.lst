------- FILE toywars.asm
    879  0a5f
    880  0a5f							;-------------------------------------------------------------------------------
    881  0a5f							; F6 hotspots: an access to $FFF6/$FFF7/$FFF8/$FFF9 selects bank 0/1/2/3.
    882  0a5f							; A switch takes effect on the next fetch, at the same address in the new bank.
    883  0a5f							; Calls into bank 2: bank 0 switches, bank 2 (at the next address) does the
    884  0a5f							; JSR and switches back, and bank 0 returns.
    885  0fc0					      ORG	$0FC0
    886  0fc0					      RORG	$FFC0
    887  0fc0				   CallInit
    888  0fc0		       ad f8 ff 	      lda	$FFF8	; bank 2 runs $FFC3-$FFC8: jsr LogicInit, lda $FFF6
    889  0fc3		       ea ea ea ea*	      ds	6, $EA
    890  0fc9		       60		      rts		; $FFC9
    891  0fd0					      ORG	$0FD0
    892  0fd0					      RORG	$FFD0
    893  0fd0				   CallLogic
    894  0fd0		       ad f8 ff 	      lda	$FFF8	; bank 2 runs $FFD3-$FFD8: jsr Logic, lda $FFF6
    895  0fd3		       ea ea ea ea*	      ds	6, $EA
    896  0fd9		       60		      rts		; $FFD9
    897  0fda
    898  0fe0					      ORG	$0FE0
    899  0fe0					      RORG	$FFE0
    900  0fe0				   ToBank1
    901  0fe0		       ad f7 ff 	      lda	$FFF7	; bank 1 continues at $FFE3: jmp PreKernel
    902  0fe3		       ea		      nop
    903  0fe4		       ea		      nop
    904  0fe5		       ea		      nop
    905  0fe6		       ad f6 ff 	      lda	$FFF6	; ($FFE6) bank 1 switches here
    906  0fe9		       4c 9b f2 	      jmp	Overscan	; ($FFE9)
    907  0fec
    908  0ff0					      ORG	$0FF0
    909  0ff0					      RORG	$FFF0
    910  0ff0				   Reset0
    911  0ff0		       ad f6 ff 	      lda	$FFF6	; every bank's reset stub: the cartridge can
    912  0ff3		       4c 00 f1 	      jmp	Start0	; power up in any bank
    913  0ffa					      ORG	$0FFA
    914  0ffa					      RORG	$FFFA
    915  0ffa		       f0 ff f0 ff*	      .word.w	Reset0, Reset0, Reset0
    916  1000
    917  1000							;===============================================================================
    918  1000							; BANK 1
    919  1000							;===============================================================================
    920  2000 ????				      SEG	bank1
    921  1000					      ORG	$1000
    922  1000					      RORG	$F000
    923  1000		       00 00 00 00*	      ds	256, 0	; Super Chip RAM window
    924  1100
