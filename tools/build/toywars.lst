    652  057c		       e8		      inx
    653  057d		       e0 05		      cpx	#NENEMY
    654  057f		       d0 d1		      bne	.so
    655  0581							; choose: walk the sorted list from position (frame & 7) mod n, wrapping,
    656  0581							; and take each enemy whose rows (event row - 1 .. feet) miss every enemy
    657  0581							; taken so far. The start moves every frame, so overlapping ones take turns.
    658  0581		       a2 00		      ldx	#0
    659  0583				   .count
    660  0583		       b4 a8		      ldy	eOrder,x
    661  0585		       b9 9e 00 	      lda	eTop,y
    662  0588		       c9 ff		      cmp	#$FF
    663  058a		       f0 05		      beq	.counted
    664  058c		       e8		      inx
    665  058d		       e0 05		      cpx	#NENEMY
    666  058f		       d0 f2		      bne	.count
    667  0591				   .counted
    668  0591		       86 b0		      stx	temp+3	; n
    669  0593		       8a		      txa
    670  0594		       f0 73		      beq	.selDone
    671  0596		       85 ae		      sta	temp+1	; candidates left
    672  0598		       a5 9c		      lda	frame
    673  059a		       29 07		      and	#7	; start: (frame & 7) mod n, so it visits every position
    674  059c		       38		      sec
    675  059d				   .mod
    676  059d		       e5 b0		      sbc	temp+3
    677  059f		       b0 fc		      bcs	.mod
    678  05a1		       65 b0		      adc	temp+3
    679  05a3		       85 af		      sta	temp+2
    680  05a5							;   The list is sorted by event row, so within each run (start..n-1, then
    681  05a5							;   0..start-1) a candidate can only overlap the last enemy taken in that
    682  05a5							;   run; in the second run it must also end above the first enemy taken in
    683  05a5							;   the first. QUEUE+0..3 (free until Schedule): last taken feet, any taken
    684  05a5							;   in this run, first run's first event row, in the second run.
    685  05a5		       a9 00		      lda	#0
    686  05a7		       85 bb		      sta	QUEUE+1
    687  05a9		       85 bd		      sta	QUEUE+3
    688  05ab		       a9 ff		      lda	#$FF
    689  05ad		       85 bc		      sta	QUEUE+2
    690  05af				   .cand
    691  05af		       a6 af		      ldx	temp+2
    692  05b1		       b4 a8		      ldy	eOrder,x
    693  05b3		       b9 9e 00 	      lda	eTop,y
    694  05b6		       f0 3b		      beq	.reject	; no usable event row
    695  05b8		       38		      sec
    696  05b9		       e9 01		      sbc	#1
    697  05bb		       85 ad		      sta	temp	; candidate event row - 1
    698  05bd		       a5 bb		      lda	QUEUE+1
    699  05bf		       f0 06		      beq	.noPrev
    700  05c1		       a5 ba		      lda	QUEUE
    701  05c3		       c5 ad		      cmp	temp
    702  05c5		       b0 2c		      bcs	.reject	; the last one taken ends at or below it
    703  05c7				   .noPrev
    704  05c7		       a5 bd		      lda	QUEUE+3
