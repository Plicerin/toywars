    646  05c1							;-------------------------------------------------------------------------------
    647  05c1							; SelectEnemies (VBLANK): decide which enemies player 1 draws this frame. Each enemy needs rows E-1 .. feet, where E is its event row (the
    648  05c1							; first row at or above top-1 that the kernel allows) and E-1 is blank. They
    649  05c1							; are sorted by E; one that overlaps an enemy already taken waits.
    650  05c1				   SelectEnemies
    651  05c1					      SUBROUTINE
    652  05c1		       a2 04		      ldx	#NENEMY-1	; (eFeet/eTop come from EnemyRows in bank 2)
    653  05c3				   .clear
    654  05c3		       b5 a8		      lda	eOrder,x	; forget last frame's choice, keep the order
    655  05c5		       29 7f		      and	#$7F
    656  05c7		       95 a8		      sta	eOrder,x
    657  05c9		       ca		      dex
    658  05ca		       10 f7		      bpl	.clear
    659  05cc							; insertion sort of eOrder by eTop (nearly sorted already: cheap)
    660  05cc		       a2 01		      ldx	#1
    661  05ce				   .so
