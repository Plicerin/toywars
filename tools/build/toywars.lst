   1715  2c02							;-------------------------------------------------------------------------------
   1716  2c02							; JetAct (X = a launched jet): four pixels right per update; every enemy on
   1717  2c02							; its shelf takes 10 damage once the nose has passed its middle. The jet's
   1718  2c02							; health byte (unused for a jet) marks the enemy slots it has hit, so each is
   1719  2c02							; hit exactly once; at most two an update (the rest the next one), so a pack
   1720  2c02							; bunched together never dies all in one frame.
   1721  2c02				   JetAct
   1722  2c02					      SUBROUTINE
   1723  2c02		       86 b4		      stx	lt3
   1724  2c04		       bd 80 f0 	      lda	R_eX,x
   1725  2c07		       18		      clc
   1726  2c08		       69 0c		      adc	#12
   1727  2c0a		       85 b1		      sta	lt0	; the nose after this step
   1728  2c0c		       bd 85 f0 	      lda	R_eLane,x
   1729  2c0f		       29 03		      and	#3
   1730  2c11		       85 b2		      sta	lt1
   1731  2c13		       a9 02		      lda	#2
   1732  2c15		       a4 b0		      ldy	KILLED
   1733  2c17		       f0 02		      beq	.hits
   1734  2c19		       a9 01		      lda	#1	; an enemy died this frame already: one hit
   1735  2c1b				   .hits
   1736  2c1b		       85 b6		      sta	lt5	; hits left this update
   1737  2c1d		       a0 04		      ldy	#NENEMY-1
   1738  2c1f				   .loop
   1739  2c1f		       b9 85 f0 	      lda	R_eLane,y	; (an empty slot's shelf is $FF, a jet's 4-6)
   1740  2c22		       c5 b2		      cmp	lt1
   1741  2c24		       d0 2e		      bne	.next
   1742  2c26		       b9 80 f0 	      lda	R_eX,y
   1743  2c29		       18		      clc
   1744  2c2a		       69 04		      adc	#4
   1745  2c2c		       c5 b1		      cmp	lt0
   1746  2c2e		       b0 24		      bcs	.next	; its middle is still ahead of the nose
   1747  2c30		       a6 b4		      ldx	lt3
   1748  2c32		       bd 8f f0 	      lda	R_eHP,x
   1749  2c35		       39 60 fd 	      and	KindBit,y	; (bits 0-4: enemy slots 0-4)
   1750  2c38		       d0 1a		      bne	.next	; hit already
   1751  2c3a		       a5 b6		      lda	lt5
   1752  2c3c		       f0 16		      beq	.next	; two this update: the next one gets it
   1753  2c3e		       c6 b6		      dec	lt5
   1754  2c40		       bd 8f f0 	      lda	R_eHP,x
   1755  2c43		       19 60 fd 	      ora	KindBit,y
   1756  2c46		       9d 0f f0 	      sta	W_eHP,x
   1757  2c49		       84 b3		      sty	lt2
   1758  2c4b		       a6 b3		      ldx	lt2
   1759  2c4d		       a9 0a		      lda	#JET_DMG
   1760  2c4f		       20 6f f5 	      jsr	Damage
   1761  2c52		       a4 b3		      ldy	lt2
   1762  2c54				   .next
   1763  2c54		       88		      dey
   1764  2c55		       10 c8		      bpl	.loop
   1765  2c57		       a6 b4		      ldx	lt3
   1766  2c59		       bd 80 f0 	      lda	R_eX,x
   1767  2c5c		       18		      clc
   1768  2c5d		       69 04		      adc	#4
   1769  2c5f		       c9 98		      cmp	#152
   1770  2c61		       b0 06		      bcs	.gone
   1771  2c63		       9d 00 f0 	      sta	W_eX,x
   1772  2c66		       4c 32 f9 	      jmp	EnemyRow
   1773  2c69				   .gone
   1774  2c69		       a9 00		      lda	#0
   1775  2c6b		       9d 0a f0 	      sta	W_eType,x
   1776  2c6e		       a9 ff		      lda	#$FF
   1777  2c70		       95 9e		      sta	eTop,x
   1778  2c72		       9d 05 f0 	      sta	W_eLane,x	; (no shelf: shots skip the empty slot)
   1779  2c75		       60		      rts
