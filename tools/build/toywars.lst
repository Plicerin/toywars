------- FILE toywars.asm
    845  09fc
    846  09fc							;-------------------------------------------------------------------------------
    847  09fc							; F6 hotspots: an access to $FFF6/$FFF7/$FFF8/$FFF9 selects bank 0/1/2/3.
    848  09fc							; A switch takes effect on the next fetch, at the same address in the new bank.
    849  09fc							; Calls into bank 2: bank 0 switches, bank 2 (at the next address) does the
    850  09fc							; JSR and switches back, and bank 0 returns.
    851  0fc0					      ORG	$0FC0
    852  0fc0					      RORG	$FFC0
    853  0fc0				   CallInit
    854  0fc0		       ad f8 ff 	      lda	$FFF8	; bank 2 runs $FFC3-$FFC8: jsr LogicInit, lda $FFF6
    855  0fc3		       ea ea ea ea*	      ds	6, $EA
    856  0fc9		       60		      rts		; $FFC9
    857  0fd0					      ORG	$0FD0
    858  0fd0					      RORG	$FFD0
    859  0fd0				   CallLogic
    860  0fd0		       ad f8 ff 	      lda	$FFF8	; bank 2 runs $FFD3-$FFD8: jsr Logic, lda $FFF6
    861  0fd3		       ea ea ea ea*	      ds	6, $EA
    862  0fd9		       60		      rts		; $FFD9
    863  0fda
    864  0fe0					      ORG	$0FE0
    865  0fe0					      RORG	$FFE0
    866  0fe0				   ToBank1
    867  0fe0		       ad f7 ff 	      lda	$FFF7	; bank 1 continues at $FFE3: jmp PreKernel
    868  0fe3		       ea		      nop
    869  0fe4		       ea		      nop
    870  0fe5		       ea		      nop
    871  0fe6		       ad f6 ff 	      lda	$FFF6	; ($FFE6) bank 1 switches here
    872  0fe9		       4c 9b f2 	      jmp	Overscan	; ($FFE9)
    873  0fec
    874  0ff0					      ORG	$0FF0
    875  0ff0					      RORG	$FFF0
    876  0ff0				   Reset0
    877  0ff0		       ad f6 ff 	      lda	$FFF6	; every bank's reset stub: the cartridge can
    878  0ff3		       4c 00 f1 	      jmp	Start0	; power up in any bank
    879  0ffa					      ORG	$0FFA
    880  0ffa					      RORG	$FFFA
    881  0ffa		       f0 ff f0 ff*	      .word.w	Reset0, Reset0, Reset0
    882  1000
    883  1000							;===============================================================================
    884  1000							; BANK 1
    885  1000							;===============================================================================
    886  2000 ????				      SEG	bank1
    887  1000					      ORG	$1000
    888  1000					      RORG	$F000
    889  1000		       00 00 00 00*	      ds	256, 0	; Super Chip RAM window
    890  1100
