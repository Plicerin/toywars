    502  0481		       4a		      lsr
    503  0482		       4a		      lsr
    504  0483		       4a		      lsr
    505  0484		       85 ae		      sta	temp+1
    506  0486		       0a		      asl
    507  0487		       0a		      asl
    508  0488		       65 ae		      adc	temp+1
    509  048a				   .last
    510  048a		       85 ae		      sta	temp+1	; second digit * 5
    511  048c		       a5 b0		      lda	temp+3
    512  048e		       0a		      asl
    513  048f		       0a		      asl
    514  0490		       65 b0		      adc	temp+3
