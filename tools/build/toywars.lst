   1664  2baa							; SlotPointers: the kernel's defender pointers, one shelf per frame plus the
   1665  2baa							; cursor's slot. The cursor's slot shows the chosen toy as a blinking ghost
   1666  2baa							; when empty, or blinks its toy.
   1667  2baa				   SlotPointers
   1668  2baa					      SUBROUTINE
   1669  2baa		       ae d3 f0 	      ldx	R_cursor
   1670  2bad		       20 bf fb 	      jsr	SlotPointer
   1671  2bb0		       ae b4 f0 	      ldx	R_toyShelf	; (the shelf the toys just took their turn on)
   1672  2bb3		       bd b9 fd 	      lda	Lane3,x
   1673  2bb6		       aa		      tax
   1674  2bb7		       20 bf fb 	      jsr	SlotPointer
   1675  2bba		       e8		      inx
   1676  2bbb		       20 bf fb 	      jsr	SlotPointer
   1677  2bbe		       e8		      inx
