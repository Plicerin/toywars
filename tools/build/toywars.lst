   1496  2aad							;-------------------------------------------------------------------------------
   1497  2aad							; JetAct (X = a launched jet): four pixels right per update; every enemy on
   1498  2aad							; its shelf takes 10 damage once the nose has passed its middle. The jet's
   1499  2aad							; health byte (unused for a jet) marks the enemy slots it has hit, so each is
   1500  2aad							; hit exactly once; at most two an update (the rest the next one), so a pack
   1501  2aad							; bunched together never dies all in one frame.
   1502  2aad				   JetAct
   1503  2aad					      SUBROUTINE
   1504  2aad		       86 b4		      stx	lt3
   1505  2aaf		       bd 80 f0 	      lda	R_eX,x
   1506  2ab2		       18		      clc
   1507  2ab3		       69 0c		      adc	#12
   1508  2ab5		       85 b1		      sta	lt0	; the nose after this step
   1509  2ab7		       bd 85 f0 	      lda	R_eLane,x
   1510  2aba		       29 03		      and	#3
   1511  2abc		       85 b2		      sta	lt1
   1512  2abe		       a9 02		      lda	#2
   1513  2ac0		       85 b6		      sta	lt5	; hits left this update
   1514  2ac2		       a0 04		      ldy	#NENEMY-1
   1515  2ac4				   .loop
   1516  2ac4		       b9 85 f0 	      lda	R_eLane,y	; (an empty slot's shelf is $FF, a jet's 4-6)
   1517  2ac7		       c5 b2		      cmp	lt1
   1518  2ac9		       d0 2e		      bne	.next
   1519  2acb		       b9 80 f0 	      lda	R_eX,y
   1520  2ace		       18		      clc
   1521  2acf		       69 04		      adc	#4
   1522  2ad1		       c5 b1		      cmp	lt0
   1523  2ad3		       b0 24		      bcs	.next	; its middle is still ahead of the nose
   1524  2ad5		       a6 b4		      ldx	lt3
   1525  2ad7		       bd 8f f0 	      lda	R_eHP,x
   1526  2ada		       39 de fd 	      and	KindBit,y	; (bits 0-4: enemy slots 0-4)
   1527  2add		       d0 1a		      bne	.next	; hit already
   1528  2adf		       a5 b6		      lda	lt5
   1529  2ae1		       f0 16		      beq	.next	; two this update: the next one gets it
   1530  2ae3		       c6 b6		      dec	lt5
   1531  2ae5		       bd 8f f0 	      lda	R_eHP,x
   1532  2ae8		       19 de fd 	      ora	KindBit,y
   1533  2aeb		       9d 0f f0 	      sta	W_eHP,x
   1534  2aee		       84 b3		      sty	lt2
   1535  2af0		       a6 b3		      ldx	lt2
   1536  2af2		       a9 0a		      lda	#JET_DMG
   1537  2af4		       20 aa f4 	      jsr	Damage
   1538  2af7		       a4 b3		      ldy	lt2
   1539  2af9				   .next
   1540  2af9		       88		      dey
   1541  2afa		       10 c8		      bpl	.loop
   1542  2afc		       a6 b4		      ldx	lt3
   1543  2afe		       bd 80 f0 	      lda	R_eX,x
   1544  2b01		       18		      clc
   1545  2b02		       69 04		      adc	#4
   1546  2b04		       c9 98		      cmp	#152
   1547  2b06		       b0 06		      bcs	.gone
   1548  2b08		       9d 00 f0 	      sta	W_eX,x
   1549  2b0b		       4c eb f7 	      jmp	EnemyRow
   1550  2b0e				   .gone
   1551  2b0e		       a9 00		      lda	#0
   1552  2b10		       9d 0a f0 	      sta	W_eType,x
   1553  2b13		       a9 ff		      lda	#$FF
   1554  2b15		       95 9e		      sta	eTop,x
   1555  2b17		       9d 05 f0 	      sta	W_eLane,x	; (no shelf: shots skip the empty slot)
   1556  2b1a		       60		      rts
