   1594  2b36							; SlotPointers: the kernel's defender pointers, one shelf per frame plus the
   1595  2b36							; cursor's slot. The cursor's slot shows the chosen toy as a blinking ghost
   1596  2b36							; when empty, or blinks its toy.
   1597  2b36				   SlotPointers
   1598  2b36					      SUBROUTINE
   1599  2b36		       ae d3 f0 	      ldx	R_cursor
   1600  2b39		       20 4b fb 	      jsr	SlotPointer
   1601  2b3c		       ae b4 f0 	      ldx	R_toyShelf	; (the shelf the toys just took their turn on)
   1602  2b3f		       bd 34 fd 	      lda	Lane3,x
   1603  2b42		       aa		      tax
   1604  2b43		       20 4b fb 	      jsr	SlotPointer
   1605  2b46		       e8		      inx
