    565  04f4		       29 04		      and	#4
    566  04f6		       f0 2a		      beq	.done
    567  04f8		       ae d0 f0 	      ldx	R_wave
    568  04fb		       e0 64		      cpx	#100
    569  04fd		       90 02		      bcc	.w
    570  04ff		       a2 63		      ldx	#99
    571  0501				   .w
