------- FILE toywars.asm
    790  09e1
    791  09e1							;-------------------------------------------------------------------------------
    792  09e1							; F6 hotspots: an access to $FFF6/$FFF7/$FFF8/$FFF9 selects bank 0/1/2/3.
    793  09e1							; A switch takes effect on the next fetch, at the same address in the new bank.
    794  09e1							; Calls into bank 2: bank 0 switches, bank 2 (at the next address) does the
    795  09e1							; JSR and switches back, and bank 0 returns.
    796  0fc0					      ORG	$0FC0
    797  0fc0					      RORG	$FFC0
    798  0fc0				   CallInit
    799  0fc0		       ad f8 ff 	      lda	$FFF8	; bank 2 runs $FFC3-$FFC8: jsr LogicInit, lda $FFF6
    800  0fc3		       ea ea ea ea*	      ds	6, $EA
    801  0fc9		       60		      rts		; $FFC9
    802  0fd0					      ORG	$0FD0
    803  0fd0					      RORG	$FFD0
    804  0fd0				   CallLogic
    805  0fd0		       ad f8 ff 	      lda	$FFF8	; bank 2 runs $FFD3-$FFD8: jsr Logic, lda $FFF6
    806  0fd3		       ea ea ea ea*	      ds	6, $EA
    807  0fd9		       60		      rts		; $FFD9
    808  0fda
    809  0fe0					      ORG	$0FE0
    810  0fe0					      RORG	$FFE0
    811  0fe0				   ToBank1
    812  0fe0		       ad f7 ff 	      lda	$FFF7	; bank 1 continues at $FFE3: jmp PreKernel
    813  0fe3		       ea		      nop
    814  0fe4		       ea		      nop
    815  0fe5		       ea		      nop
    816  0fe6		       ad f6 ff 	      lda	$FFF6	; ($FFE6) bank 1 switches here
    817  0fe9		       4c 9b f2 	      jmp	Overscan	; ($FFE9)
    818  0fec
    819  0ff0					      ORG	$0FF0
    820  0ff0					      RORG	$FFF0
    821  0ff0				   Reset0
    822  0ff0		       ad f6 ff 	      lda	$FFF6	; every bank's reset stub: the cartridge can
    823  0ff3		       4c 00 f1 	      jmp	Start0	; power up in any bank
    824  0ffa					      ORG	$0FFA
    825  0ffa					      RORG	$FFFA
    826  0ffa		       f0 ff f0 ff*	      .word.w	Reset0, Reset0, Reset0
    827  1000
    828  1000							;===============================================================================
    829  1000							; BANK 1
    830  1000							;===============================================================================
    831  2000 ????				      SEG	bank1
    832  1000					      ORG	$1000
    833  1000					      RORG	$F000
    834  1000		       00 00 00 00*	      ds	256, 0	; Super Chip RAM window
    835  1100
